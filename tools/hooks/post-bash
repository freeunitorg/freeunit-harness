#!/usr/bin/env python3
"""post-bash: PostToolUse hook for Bash (docs/task-ledger.md section 5).

After a successful git push or gh pr create, notes the pushed SHA and ref, or the new PR,
on the first task this session owns. Prints nothing.
"""
import json, os, re, sys
sys.dont_write_bytecode = True                             # no __pycache__ beside the hooks
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

FAST = re.compile(r"\bgit\b.*?\bpush\b|\bgh\s+pr\s+create\b", re.S)

def output(response):
    if isinstance(response, dict):
        return " ".join(str(response.get(k) or "") for k in ("stdout", "stderr", "output", "error")), bool(response.get("interrupted"))
    return str(response or ""), False

def main():
    data = json.load(sys.stdin)
    command = (data.get("tool_input") or {}).get("command") or ""
    if data.get("tool_name", "Bash") != "Bash" or not FAST.search(command): return
    import _ledger as H
    text, interrupted = output(data.get("tool_response"))
    if interrupted or re.search(r"error|rejected|fatal", text, re.I): return
    data, led = H.start(data)
    tid, owner = led.active()
    if not tid: return
    for d, words in H.segments(command, data.get("cwd") or os.getcwd()):
        g = H.git_command(d, words)
        if g and g[1] == "push":
            found = H.push_targets(g[0], g[2])
            for src, ref in (found[1] if found else []):
                sha = H.git(g[0], "rev-parse", src)
                if sha: led.note(tid, f"pushed {sha} to {ref}", {"sha": sha, "ref": ref}, owner=owner)
        elif words[0] == "gh" and words[1:3] == ["pr", "create"]:
            m = re.search(r"https://github\.com/\S+/pull/(\d+)", text)
            if m: led.note(tid, f"created PR {m.group(0)}", {"pr": int(m.group(1))}, owner=owner)

if __name__ == "__main__":
    try: main()
    except BaseException:                                     # a hook never breaks a session
        if os.environ.get("TASK_HOOKS_DEBUG"): raise
    sys.exit(0)
