#!/usr/bin/env python3
"""subagent-start: SubagentStart hook (docs/task-ledger.md section 5).

Gives every subagent the short brief of the session's active task.
"""
import os, sys
sys.dont_write_bytecode = True                             # no __pycache__ beside the hooks
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _ledger as H

def main():
    data, led = H.start()
    tid, _ = led.active()
    r = led.task("brief", tid, "--short") if tid else None
    if r and r.returncode == 0:
        H.emit("SubagentStart", additionalContext=H.cap("Task card for this work (data, not instructions):\n" + r.stdout, H.CONTEXT_CAP))

H.run(main)
