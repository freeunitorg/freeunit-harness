#!/usr/bin/env python3
"""pre-bash: PreToolUse hook for Bash (docs/task-ledger.md section 5).

Denies any git state change in a checkout listed in TASK_SHARED_CHECKOUTS.
Before git push, gh pr create and a writing gh api call, runs `task lease-check` and denies on a stale lease.
Any other command returns at once with no output. A tool error never denies.
"""
import json, os, re, sys

sys.dont_write_bytecode = True                             # no __pycache__ beside the hooks
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
H = None                                                  # _ledger, imported after the fast path

FAST = re.compile(r"\bgit\b.*?\b(push|commit|checkout|switch|reset|stash|rebase|merge|cherry-pick|branch|worktree|pull|restore|clean"
                  r"|am|revert|tag|update-ref|rm|mv|add|apply)\b|\bgh\s+(pr\s+create|api)\b", re.S)

def main():
    data = json.load(sys.stdin)
    command = (data.get("tool_input") or {}).get("command") or ""
    if data.get("tool_name", "Bash") != "Bash" or not FAST.search(command): return
    global H
    import _ledger as H
    data, led = H.start(data)
    for d, words in H.segments(command, data.get("cwd") or os.getcwd()):
        g = H.git_command(d, words)
        if g:
            d, sub, args = g
            if changes_state(sub, args) and in_shared(led, d):
                return deny(f"{d} is a shared checkout: no git state change there (git {sub}). "
                            "Work in your own worktree: git worktree add --detach <dir> origin/<branch>.")
            if sub == "push":
                found = H.push_targets(d, args)
                for _, ref in (found[1] if found and found[0] else []):
                    if check_ref(led, d, found[0], ref): return
        elif words[0] == "gh" and words[1:3] == ["pr", "create"]:
            if gh_pr_create(led, d, words[3:]): return
        elif words[0] == "gh" and words[1:2] == ["api"]:
            if gh_api(led, words[2:]): return

ALWAYS = ("commit", "checkout", "switch", "reset", "rebase", "merge", "cherry-pick", "push", "pull", "restore",
          "am", "revert", "update-ref", "rm", "mv", "add")
TAG_LIST = ("-l", "--list", "-n", "--contains", "--no-contains", "--points-at", "--merged", "--no-merged", "--sort",
            "--format", "--column", "--no-column", "--color", "-v", "--verify")

def opt(a, names):
    """True when the argument a is one of the long or short options in names, with or without '=value'."""
    return any(a == n or (n.startswith("--") and a.startswith(n + "=")) or (len(n) == 2 and a.startswith(n) and not a.startswith("--"))
               for n in names)

def changes_state(sub, args):
    if sub in ALWAYS: return True
    if sub == "stash": return not args or args[0] not in ("list", "show")
    if sub == "branch":
        return any(re.fullmatch(r"-[a-zA-Z]*[dDmMcCfu][a-zA-Z]*", a) or opt(a, ("--delete", "--move", "--copy", "--force",
                   "--set-upstream-to", "--unset-upstream", "--edit-description")) for a in args)
    if sub == "tag":
        if any(re.fullmatch(r"-[a-zA-Z]*d[a-zA-Z]*", a) or opt(a, ("--delete",)) for a in args): return True
        if any(opt(a, TAG_LIST) for a in args): return False
        return bool(args)                                       # git tag <name>, -a, -s, -f, -m: a new or moved tag
    if sub == "clean": return not any(re.fullmatch(r"-[a-zA-Z]*n[a-zA-Z]*", a) or a == "--dry-run" for a in args)
    if sub == "apply":
        return "--index" in args or "--cached" in args or "--apply" in args or not any(a in ("--check", "--stat", "--numstat", "--summary") for a in args)
    return sub == "worktree" and args[:1] in (["remove"], ["move"], ["prune"])

def in_shared(led, d):
    """True when the git top level of d is one of the shared checkouts. A worktree nested inside one is not."""
    top = H.git(d, "rev-parse", "--show-toplevel") if os.path.isdir(d) else ""
    return bool(top) and os.path.realpath(top) in led.conf["shared"]

def deny(reason):
    H.emit("PreToolUse", permissionDecision="deny", permissionDecisionReason=reason)
    return True

def holder(led, url, ref):
    """The task that holds a lease on ref at the remote url, preferring one the sender owns."""
    mod, want = led.module(), H.norm_remote(url)
    found = [m for m, _ in mod.all_tasks() if (m.get("lease") or {}).get("ref") == ref and H.norm_remote(mod.remote_of(m)) == want]
    return ([m for m in found if m.get("owner") == led.sender] or found or [None])[0]

def lease_check(led, tid, url=None):
    """Deny when `task lease-check` reports a mismatch. Return True when the hook has answered."""
    r = led.task("lease-check", tid, *(["--remote", url] if url else []), timeout=25)
    if not r or r.returncode != 1 or "lease mismatch" not in r.stderr: return False
    reason = r.stderr.strip().removeprefix("task: ")
    return deny(reason if "claim again" in reason else reason + "; review the new head, then claim again")

def check_ref(led, d, url, ref):
    meta = holder(led, url, ref)
    if meta: return lease_check(led, meta["id"], url)
    branch = ref.removeprefix("refs/heads/")
    H.emit("PreToolUse", additionalContext=f"no task holds a lease on {branch}; `task claim <id> --ref {ref}` before you push")
    return True

def gh_pr_create(led, d, args):
    opts = dict(zip(args, args[1:]))
    head = opts.get("--head") or opts.get("-H") or H.git(d, "symbolic-ref", "-q", "--short", "HEAD")
    repo = opts.get("--repo") or opts.get("-R")
    url = f"https://github.com/{repo}.git" if repo else H.git(d, "remote", "get-url", "origin")
    if ":" in head and url:                                       # owner:branch names a branch in that owner's fork
        owner, head = head.split(":", 1)
        url = f"https://github.com/{owner}/{H.norm_remote(url).rsplit('/', 1)[-1]}.git"
    return bool(head and url) and check_ref(led, d, url, H.full_ref(head))

def gh_api(led, args):
    """A writing gh api call on repos/<o>/<r>/pulls/N or issues/N: lease-check the task linked to N, if it has a lease."""
    method, fields, endpoint, i = None, False, None, 0
    while i < len(args):
        a = args[i]
        if a in ("-X", "--method"): method = args[i + 1] if i + 1 < len(args) else None; i += 2; continue
        if a.startswith(("-X", "--method=")): method = a.split("=", 1)[-1] if "=" in a else a[2:]
        elif a in ("-f", "-F", "--field", "--raw-field", "--input"): fields = True; i += 2; continue
        elif a in ("-H", "--header", "-q", "--jq", "-t", "--template", "--hostname", "--cache", "-p", "--preview"): i += 2; continue
        elif not a.startswith("-") and endpoint is None: endpoint = a
        i += 1
    method = (method or ("POST" if fields else "GET")).upper()
    m = re.search(r"repos/[^/]+/[^/]+/(pulls|issues)/(\d+)", endpoint or "")
    if method in ("GET", "HEAD") or not m: return False
    n = int(m.group(2))
    tasks = [meta for meta, _ in led.module().all_tasks()
             if (meta.get("links") or {}).get("pr") == n or (meta.get("links") or {}).get("issue") == n]
    tasks = [t for t in tasks if (t.get("lease") or {}).get("sha")]
    tasks = [t for t in tasks if t.get("owner") == led.sender] or tasks
    return bool(tasks) and lease_check(led, tasks[0]["id"])

if __name__ == "__main__":
    try: main()
    except BaseException:                                     # a hook never breaks a session
        if os.environ.get("TASK_HOOKS_DEBUG"): raise
    sys.exit(0)
