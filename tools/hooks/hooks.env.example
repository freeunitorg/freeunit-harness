# Configuration of the task-ledger hooks (tools/hooks). Copy to run/hooks.env and edit there;
# run/ is not tracked. A variable set in the environment wins over this file.
# Relative paths resolve against the harness root.

# The ledger. When this directory does not exist, every hook does nothing.
TASK_ROOT=run/tasks

# The bus log.
INBOX_LOG=run/inbox/bus.log

# The sender written on every line, role@tool.
INBOX_SENDER=orchestrator@claude

# Absolute paths of shared checkouts, separated by colons. Every git state change there is denied.
# Example: TASK_SHARED_CHECKOUTS=/path/to/shared/checkout:/path/to/another
TASK_SHARED_CHECKOUTS=
