diff -ruN a/tools/perf-job.sh b/tools/perf-job.sh
--- a/tools/perf-job.sh	2026-10-08 17:17:07.006958714 +0200
+++ b/tools/perf-job.sh	2026-10-08 17:17:07.026781177 +0200
@@ -76,7 +76,7 @@
 read_kv "$JOBFILE" "$JOB_KEYS"
 [ -n "$JOB" ] && [ -n "$REV_A" ] && [ -n "$REV_B" ] || usage_die "$JOBFILE needs JOB, REV_A and REV_B"
 [[ "$JOB" =~ ^[A-Za-z0-9._-]+$ ]] || usage_die "JOB may hold only letters, digits, dot, dash, underscore"
-case "$WORKLOAD" in hello|static1k|capp) ;; *) usage_die "WORKLOAD $WORKLOAD is not built yet (hello, static1k, capp)" ;; esac
+case "$WORKLOAD" in hello|server|static1k|capp) ;; *) usage_die "WORKLOAD $WORKLOAD is not built yet (hello, server, static1k, capp)" ;; esac
 [[ "$REPS" =~ ^[0-9]+$ ]] && [ "$REPS" -ge 2 ] && [ $((REPS % 2)) = 0 ] \
     || usage_die "REPS must be even and at least 2: each normal block needs its swapped twin"
 JOBDIR=$(cd "$(dirname "$JOBFILE")" && pwd)
diff -ruN a/tools/perf-lab/cells.sh b/tools/perf-lab/cells.sh
--- a/tools/perf-lab/cells.sh	2026-10-08 17:17:07.009117419 +0200
+++ b/tools/perf-lab/cells.sh	2026-10-08 17:17:07.026995944 +0200
@@ -68,7 +68,7 @@
 
 conf_for() {  # tree
     case "$WORKLOAD" in
-    hello) cat <<EOF
+    hello|server) cat <<EOF
 {"listeners": {"127.0.0.1:$PORT": {"pass": "applications/p"}},
  "applications": {"p": {"type": "php", "root": "/lab/www", "processes": $APP_PROCS,
    "options": {"admin": {"opcache.enable": "1", "opcache.validate_timestamps": "0"}}}}}
@@ -89,6 +89,7 @@
 }
 url_for() {
     case "$WORKLOAD" in hello) echo "http://127.0.0.1:$PORT/hello.php" ;;
+    server) echo "http://127.0.0.1:$PORT/server.php" ;;
     static1k) echo "http://127.0.0.1:$PORT/1k.txt" ;; capp) echo "http://127.0.0.1:$PORT/" ;; esac
 }
 
diff -ruN a/tools/perf-lab/www/server.php b/tools/perf-lab/www/server.php
--- a/tools/perf-lab/www/server.php	1970-01-01 01:00:00.000000000 +0100
