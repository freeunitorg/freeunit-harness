# Job 16: libunit message cost on the C external app (no interpreter).
# A = origin/master, B = origin/master plus the perf/libunit-message-cost patch.
# The app sends header with content, a 16 KiB-chunk body and the last message.
JOB=16-msgcost-capp
ISSUE=https://github.com/freeunitorg/freeunit/issues/597
REV_A=origin/master
REV_B=origin/master
PATCH_B=patches/libunit-message-cost.diff
WORKLOAD=capp
CONNS=32 256
WARM=2
DUR=8
REPS=2
PERF=1
STRACE=1
PRIMARY=s_instructions
EXPECT=s_instructions lower in both cells; asys_sendmsg from about 3 to under 1 per request
FALSIFY=NO CLAIM for s_instructions in both cells
