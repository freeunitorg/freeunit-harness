# Lab configuration: hosts, remote paths and perf lab settings.
# Copy to run/lab.env (gitignored) and fill in. Override the path with
# LAB_ENV=/path/to/file. tools/lib/env.sh is the one reader of this file.
#
# The file is optional. Without it, local work runs as usual: `make` targets,
# `tools/unit-build -t local`, the tests in tools/tests. Remote builds
# (unit-build -t remote/alpine), tools/hosts and the perf lab need it, or the
# same keys set in the environment.
#
# Format: KEY=VALUE, one per line; # starts a comment. Quotes around a value
# are stripped once, and a value is never evaluated. A variable already set
# (not empty) in the environment wins over this file. A key that is not
# listed here is a warning, and tools/perf-job.sh refuses it.

# --- perf lab, required by tools/perf-job.sh ----------------------------------
PERF_HOST=perf-box.example          # ssh name of the measurement box (role "lab")
SSH_USER=                           # ssh user for every role; empty: use ~/.ssh/config
REMOTE_WORKDIR=/srv/perf-lab        # large disk on PERF_HOST; trees, builds, runs
CLAIM_DIR=/srv/projects             # where box claims live (CLAIMED-<who>-<purpose>)
LAB_IMAGE=freeunit-perf-lab:1       # image built from tools/perf-lab/Dockerfile on PERF_HOST
OHA=/usr/local/bin/oha              # oha binary on PERF_HOST, mounted into the container
REPO_URL=https://github.com/freeunitorg/freeunit.git  # source the box fetches revisions from
SERVER_CPUS=0,1                     # unitd; keep their SMT siblings out of LOAD_CPUS
LOAD_CPUS=2,3,6,7                   # oha
DB_CPUS=4,5                         # database container when the workload has one (Drupal); must not overlap the two above
PERF_WINDOW=01:00-06:00             # box local time; jobs longer than SHORT_JOB_MIN wait for it
GOVERNOR=record                     # record | require-performance

# --- perf lab, optional, defaults shown ----------------------------------------
LAB_DOCKER_HOST=                    # image builds and cross-arch (not DOCKER_HOST: docker reads that)
SHORT_JOB_MIN=15                    # jobs at or under this many minutes ignore PERF_WINDOW
IDLE_MAX_PCT=5                      # box CPU busy percent allowed by the idle gate
WAIT_MAX_MIN=30                     # how long a busy box is waited for before BUSY
LEGACY_CLAIM_MAX_H=72               # an empty legacy claim file older than this is ignored, with a warning
BUILD_JOBS=8                        # make -j inside the lab image
LAB_RESULTS=                        # local results dir; empty: run/perf-lab

# --- host roles (read by tools/hosts; used by unit-build -H) -------------------
#
# A role is a name for a machine, so nothing in a tracked file has to carry one
# contributor's host names. `tools/hosts list` shows what resolves.
# Another NAME_HOST key adds a role "name" for tools/hosts.
#
BUILD_HOST=                         # build: native build and test box; no fallback, empty means -H build fails
ALPINE_HOST=                        # alpine: musl builder with gdb; empty: LAB_DOCKER_HOST
INFER_HOST=                         # infer: optional GPU box for self-hosted open weights
BOT_HOST=                           # bot: optional always-on agent host

# --- remote build paths (tools/unit-build, tools/hosts root and cache) ---------
BUILD_ROOT=                         # unit-build remote root; empty: REMOTE_WORKDIR
BUILD_CACHE=                        # unit-build cache dir; empty: BUILD_ROOT/cache
ALPINE_BUILD_IMAGE=registry.example/aports-build:edge  # musl build image with gdb; required by -t alpine

# --- sources --------------------------------------------------------------------
UNIT_REPO=                          # FreeUnit checkout for perf-bisect.sh and session-extract; empty: UNIT_SRC, else ./src
