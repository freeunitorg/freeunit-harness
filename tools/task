    p = argparse.ArgumentParser(prog="task", description="The task ledger, docs/task-ledger.md.")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("new"); s.add_argument("id"); s.add_argument("--title", required=True); s.add_argument("--url")
    s.add_argument("--dep", action="append", default=[]); s.add_argument("--repo", default="freeunitorg/freeunit")
    s.add_argument("--remote"); s.add_argument("--embargo", action="store_true")
    s = sub.add_parser("claim"); s.add_argument("id"); s.add_argument("--ref"); s.add_argument("--remote")
    s.add_argument("--worktree"); s.add_argument("--ttl", type=int)
    s = sub.add_parser("note"); s.add_argument("id"); s.add_argument("text", nargs="+"); s.add_argument("--json")
    s = sub.add_parser("link"); s.add_argument("id"); s.add_argument("pairs", nargs="+", metavar="key=value")
    s = sub.add_parser("gate"); s.add_argument("id"); s.add_argument("gate"); s.add_argument("state", choices=("pass", "fail", "n/a"))
    s.add_argument("--evidence")
    s = sub.add_parser("next"); s.add_argument("id"); s.add_argument("text", nargs="+")
    s = sub.add_parser("handoff"); s.add_argument("id"); s.add_argument("--to")
    s = sub.add_parser("done"); s.add_argument("id"); s.add_argument("--maintainer", action="store_true")
    s = sub.add_parser("show"); s.add_argument("id")
    s = sub.add_parser("log"); s.add_argument("id"); s.add_argument("--since")
    s = sub.add_parser("who"); s.add_argument("key", choices=("pr", "issue", "worktree", "review")); s.add_argument("value")
    sub.add_parser("mine")
    s = sub.add_parser("ready"); s.add_argument("--role")
    s = sub.add_parser("lease-check"); s.add_argument("id", nargs="?"); s.add_argument("--cwd", action="store_true"); s.add_argument("--remote")
    sub.add_parser("reap")
    s = sub.add_parser("brief"); s.add_argument("id"); s.add_argument("--for", dest="mode", choices=("resume", "implement", "review"), default="resume")
    s.add_argument("--short", action="store_true"); s.add_argument("--public", action="store_true")
    s = sub.add_parser("backfill"); s.add_argument("date", nargs="?")
    a = p.parse_args(argv)
    check_sender()
    commands = {"new": cmd_new, "claim": cmd_claim, "note": cmd_note, "link": cmd_link, "gate": cmd_gate, "next": cmd_next,
                "handoff": cmd_handoff, "done": cmd_done, "show": cmd_show, "log": cmd_log, "who": cmd_who, "mine": cmd_mine,
                "ready": cmd_ready, "lease-check": cmd_lease_check, "reap": cmd_reap, "brief": cmd_brief, "backfill": cmd_backfill}
    commands[a.cmd](a)

if __name__ == "__main__":
    main()
