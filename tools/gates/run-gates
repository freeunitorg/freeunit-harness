#!/usr/bin/env bash
#
# run-gates — the local gates an agent runs on a FreeUnit checkout before a
# push.  Each gate prints "G<n>: PASS" or "G<n>: FAIL: ...".  The exit status
# is not zero when a gate failed.  The logs go to a new directory under
# $TMPDIR (or /tmp) for each run.
#
#   G1  --hardening=strict build, gcc and clang   build-test.yml hardening-strict
#   G2  build and a pytest slice (-t)             build-test.yml
#   G3  ASan+UBSan build and test_static.py       sanitize.yml
#   G4  short fuzz run                            fuzzing.yml
#   G5  ast-grep rule tests and baseline          lint-astgrep.yml ast-grep
#   G6  @contract comments for the names in tools/gates/contract_functions.txt
#   G7  mixed atomic/plain accesses, clang-query  #730 #736 #741 #742
#   G8  #!/bin/sh scripts: dash/ash -n and trap greps, report-only
#
#   tools/gates/run-gates [-s <checkout>] [-g 5,6,7,8] [-t "test_a.py test_b.py"]
#                         [--fuzz-seconds 20] [--allow-local-build]
#
#   -s is the FreeUnit checkout to check.  Without it: $UNIT_SRC, else the
#   harness ./src (`make src` clones it).  The tree must hold ./configure; a
#   tree without one is refused before any gate runs.  The default gate set is
#   5,6,7,8: the gates that leave the checkout untouched.  G7 configures a copy
#   of it, so the default run needs clang and clang-query.
#
#   G1 to G4 build.  A build belongs on the build host, not on this machine:
#   `tools/unit-build -t remote -H build --hardening tests` (AGENTS.md, "Which
#   machine does which job").  ./configure also rewrites the root Makefile and
#   build/ of the tree it runs in, so running them against a worktree you are
#   editing clobbers its configured state.  So G1 to G4 refuse to run unless
#   --allow-local-build is given.  They are kept here because they mirror the
#   CI jobs named above; use them only on a throwaway checkout.
#
#   G5 reads the ast-grep rules, the baseline and the checker from the
#   checkout, not from the harness: tools/ast-grep/ stays in the FreeUnit
#   repository.  A checkout without tools/ast-grep/ fails G5; it does not pass
#   it.
#
#   G6 reads tools/gates/contract_functions.txt next to this script.  That
#   list is empty, so G6 checks nothing today.
#
#   G7 configures a throwaway copy of the checkout: clang-query needs the
#   build/include headers a configure writes, and a configure in the checkout
#   itself is exactly what G1 to G4 refuse.  It therefore needs no
#   --allow-local-build, but it needs clang-query (Debian/Ubuntu package
#   clang-tools-21; the binary sits in /usr/lib/llvm-*/bin, not on PATH) and
#   clang.  Its matcher is tools/gates/atomic_query.txt and its baseline is
#   tools/gates/atomic_baseline.txt.  The baseline was generated on the tree
#   with #736, #741 and #742, so a checkout without those PRs reports the
#   sites they fix, which is correct: they are the same class until they
#   merge.  It is in the default set now; -g 5,6 leaves it out for a run on a
#   machine without clang-query.
#
#   G8 runs tools/gates/shell_check on each tracked "#!/bin/sh" file: dash -n,
#   busybox ash -n (a local busybox, else alpine:3.22 in docker), and greps
#   for the traps in docs/shell.md that shellcheck -s sh misses.  It is
#   report-only: WARN lines, then "G8: PASS".  It fails only when the check
#   cannot read the checkout.  A missing shell prints a SKIP line.  It takes
#   under one second with local dash and busybox, so it is in the default set.

set -u

HARNESS_GATES=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd) || exit
CONTRACTS=$HARNESS_GATES/contract_functions.txt

REPO=
GATES=5,6,7,8
# G1 builds no language module.  Thus the slice has only tests that need
# no language module.
SLICE="test_static.py test_variables.py test_return.py"
FUZZ_SECONDS=20
PYTEST=${PYTEST:-pytest}
ALLOW_LOCAL_BUILD=0
FAILED=0

export JAVA_TOOL_OPTIONS=

while [ $# -gt 0 ]; do
    case "$1" in
        -s|--src)       REPO=${2:?-s needs a checkout}; shift 2 ;;
        -g|--gates)     GATES=${2:?-g needs a gate list}; shift 2 ;;
        -t|--tests)     SLICE=${2:?-t needs a test list}; shift 2 ;;
        --fuzz-seconds) FUZZ_SECONDS=${2:?--fuzz-seconds needs a number}; shift 2 ;;
        --allow-local-build) ALLOW_LOCAL_BUILD=1; shift ;;
        -h|--help)      sed -n '3,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
        *)              echo "run-gates: unknown argument: $1" >&2; exit 2 ;;
    esac
done

# The same order as tools/unit-build: -s, then $UNIT_SRC, then the harness
# clone.
if [ -z "$REPO" ]; then
    REPO=${UNIT_SRC:-$HARNESS_GATES/../../src}
fi

if [ ! -d "$REPO" ]; then
    echo "run-gates: no checkout at $REPO" >&2
    echo "run-gates: pass one with -s <checkout>, or set UNIT_SRC," \
         "or run 'make src'" >&2
    exit 2
fi

REPO=$(cd "$REPO" && pwd) || exit 2

if [ ! -f "$REPO/configure" ]; then
    echo "run-gates: $REPO holds no ./configure, so it is not a FreeUnit" \
         "checkout" >&2
    exit 2
fi

echo "checkout: $REPO"

cd "$REPO" || exit 2

# One directory for each run.  Thus two users or two runs do not write
# the same log file.
LOGDIR=$(mktemp -d "${TMPDIR:-/tmp}/freeunit-gates.XXXXXX") || exit

fail() {
    echo "G$1: FAIL: $2"
    FAILED=1
    return 1
}

# run <gate> <log name> <command...>: on failure, show the tail of the log.
run() {
    local log="$LOGDIR/g$1-$2.log"

    if "${@:3}" >"$log" 2>&1; then
        return 0
    fi

    tail -n 40 "$log"
    fail "$1" "$2 failed, see $log"
}

# local_build_allowed <gate>: a gate that builds runs only when the caller
# accepted that the build happens on this machine and in this tree.
local_build_allowed() {
    if [ "$ALLOW_LOCAL_BUILD" = 1 ]; then
        return 0
    fi

    fail "$1" "builds on this machine; a build belongs on the build host
  (tools/unit-build -t remote -H build --hardening tests).  ./configure also
  rewrites the root Makefile and build/ of $REPO.  Pass --allow-local-build to
  run it here anyway, on a checkout you can throw away."
}

gate_1() {
    local cc rc=0

    local_build_allowed 1 || return 1

    for cc in gcc clang; do
        if ! command -v "$cc" >/dev/null; then
            echo "G1 ($cc): SKIP: not found"
            continue
        fi

        rm -rf build
        run 1 "$cc-configure" \
            env CC="$cc" ./configure --zlib --openssl --hardening=strict \
            && run 1 "$cc-build" make -j2 || rc=1
    done

    return $rc
}

gate_2() {
    local_build_allowed 2 || return 1

    # G2 can run alone.  Then no build is configured yet.
    if [ ! -f build/Makefile ] || [ ! -f Makefile ]; then
        run 2 configure ./configure --openssl || return 1
    fi

    run 2 build make -j2 \
        && run 2 pytest sh -c "cd test && $PYTEST $SLICE" \
        || return 1

    # A slice in which each test is skipped also exits with 0.
    grep -qE '\b[1-9][0-9]* passed\b' "$LOGDIR/g2-pytest.log" \
        || fail 2 "no test ran, see $LOGDIR/g2-pytest.log"
}

gate_3() {
    local asan="-fsanitize=address,undefined" logs rc

    local_build_allowed 3 || return 1

    rm -rf build
    run 3 configure env ASAN_OPTIONS=detect_leaks=0 ./configure --debug \
        --tests --openssl --cc-opt="$asan -fno-omit-frame-pointer -O1" \
        --ld-opt="$asan" \
        && run 3 build make -j2 unitd \
        || return 1

    # A sanitizer report from unitd goes only to unit.log.  pytest can pass
    # with such a report.  Keep the logs in a private directory, and scan
    # them as CI does (.github/workflows/sanitize.yml).
    logs=$(mktemp -d)

    # The router runs as an unprivileged user.  It must reach the files
    # under this directory.
    chmod 755 "$logs"

    # TZ as in sanitize.yml: test_static_last_modified_is_gmt skips under
    # UTC.
    run 3 pytest env ASAN_OPTIONS=detect_leaks=0 \
        UBSAN_OPTIONS=print_stacktrace=1 TMPDIR="$logs" TZ=Asia/Kolkata \
        sh -c "cd test && $PYTEST --save-log test_static.py"
    rc=$?

    run 3 sanitizer-reports .github/scripts/check-sanitizer-reports.sh \
        "$logs" .github/sanitizer-allowlist.txt || rc=1

    rm -rf "$logs"

    return $rc
}

# The fuzz build as in fuzzing/build-fuzz.sh, but a failed configure or
# make fails G4: build-fuzz.sh returns 0 even then, and a parallel make can
# build fuzz_basic before another target fails.  run-ci.sh makes a UBSan
# report fail the run (halt_on_error=1), and it writes new inputs to
# build/fuzz-corpora/, not to the tracked seed corpus.
gate_4() {
    local flags="-g -DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION"

    local_build_allowed 4 || return 1

    flags="$flags -fsanitize=address,undefined -fsanitize=fuzzer-no-link"

    rm -f build/fuzz_basic

    run 4 configure env CC=clang CXX=clang++ CFLAGS="$flags" \
            CXXFLAGS="$flags" \
            ./configure --no-regex --no-pcre2 --fuzz=-fsanitize=fuzzer \
        && run 4 build make fuzz -j"$(nproc)" \
        && run 4 fuzz sh fuzzing/run-ci.sh -t "$FUZZ_SECONDS" fuzz_basic
}

# The same checks as the ast-grep job in .github/workflows/lint-astgrep.yml.
# The rules, the baseline and the two checkers come from the checkout: they
# live in the FreeUnit repository, not in this harness.
gate_5() {
    local dir="$REPO/tools/ast-grep" f

    if ! command -v ast-grep >/dev/null; then
        fail 5 "ast-grep not installed"
        return
    fi

    # A missing tools/ast-grep/ must fail G5.  Without this check ast-grep
    # would scan nothing and the gate would look clean.
    for f in sgconfig.yml check_baseline.py check_baseline_test.py \
             baseline.json
    do
        if [ ! -f "$dir/$f" ]; then
            fail 5 "no $dir/$f: this checkout has no tools/ast-grep/"
            return
        fi
    done

    run 5 rule-tests ast-grep test -c "$dir/sgconfig.yml" \
        && run 5 baseline-tests python3 "$dir/check_baseline_test.py" \
        && run 5 baseline python3 "$dir/check_baseline.py"
}

# contract_above <file> <line>: the line starts a function definition,
# and the comment block directly above it has an "@contract" line.  A
# declaration ends with ";" before any "{", so it does not count.  Only
# the lines of the type above the name and "#" lines are skipped: a line
# with other text, or a blank line, ends the search, so a comment of an
# earlier function or declaration does not count.
contract_above() {
    awk -v def="$2" '
        { text[NR] = $0 }
        END {
            # A definition: "{" comes before ";" after the name.
            for (i = def; i <= NR; i++) {
                if (text[i] ~ /;/) {
                    exit 1
                }

                if (text[i] ~ /\{/) {
                    break
                }
            }

            if (i > NR) {
                exit 1
            }

            i = def - 1

            # The type lines, for example "static nxt_int_t": names,
            # blanks and "*" only, and preprocessor lines such as
            # "#if (NXT_HAVE_X)" between the comment and the definition.
            # Any other line, such as a declaration that ends with ";" or a
            # blank line, ends the search.
            while (i > 0 && (text[i] ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_[:space:]*]*$/ \
                             || text[i] ~ /^#/)) {
                i--
            }

            if (i < 1 || text[i] !~ /\*\/[[:space:]]*$/) {
                exit 1
            }

            # The comment block, from its end up to its start.
            for (; i > 0; i--) {
                if (text[i] ~ /@contract/) {
                    exit 0
                }

                if (text[i] ~ /\/\*/) {
                    exit 1
                }
            }

            exit 1
        }
    ' "$1"
}

gate_6() {
    local fn file line found names=0 rc=0

    if [ ! -f "$CONTRACTS" ]; then
        fail 6 "no $CONTRACTS"
        return
    fi

    if [ ! -d src ]; then
        fail 6 "no $REPO/src to search"
        return
    fi

    while IFS= read -r fn; do
        case "$fn" in
            ''|'#'*) continue ;;
        esac

        names=$((names + 1))
        found=0

        while IFS=: read -r file line _; do
            if contract_above "$file" "$line"; then
                found=1
                break
            fi
        # The usual style has the type on the line above the name:
        #   static void
        #   nxt_conn_wait(...)
        # Also accept the type and the name on one line.
        done < <(grep -rn -E "^([A-Za-z_][A-Za-z0-9_ *]*[ *])?$fn\(" src \
                 --include='*.c')

        if [ "$found" = 0 ]; then
            echo "  missing @contract for: $fn"
            rc=1
        fi
    done < "$CONTRACTS"

    # Say so, rather than report a pass that proves nothing.
    if [ "$names" = 0 ]; then
        echo "  no names in $CONTRACTS: nothing to check"
    else
        echo "  checked $names function name(s)"
    fi

    [ "$rc" = 0 ] || fail 6 "functions without @contract"
}

ran=0

# The mixed atomic/plain access check.  The matcher, the baseline and the
# checker live next to this script.  A missing clang-query fails the gate:
# a check that cannot run must not look clean.
gate_7() {
    local cq=

    if [ -n "${CLANG_QUERY:-}" ]; then
        cq=$CLANG_QUERY
    else
        cq=$(command -v clang-query || true)
    fi

    if [ -z "$cq" ]; then
        # The distro package does not put the binary on PATH.
        cq=$(ls -d /usr/lib/llvm-*/bin/clang-query 2>/dev/null \
             | sort -r | head -1)
    fi

    if [ -z "$cq" ] || [ ! -x "$cq" ]; then
        fail 7 "clang-query not installed (package clang-tools-21); the
  binary is in /usr/lib/llvm-*/bin.  Set CLANG_QUERY to override."
        return
    fi

    export CLANG_QUERY=$cq

    run 7 atomic python3 "$HARNESS_GATES/atomic_check.py" "$REPO"
}

# Report-only: the WARN lines go to the terminal and to the log.
gate_8() {
    local log="$LOGDIR/g8-shell.log"

    sh "$HARNESS_GATES/shell_check" "$REPO" >"$log" 2>&1
    local rc=$?

    cat "$log"
    [ "$rc" = 0 ] || fail 8 "shell_check exited $rc, see $log"
}

for g in 1 2 3 4 5 6 7 8; do
    case ",$GATES," in
        *",$g,"*) ;;
        *) continue ;;
    esac

    ran=1
    echo "==> G$g"

    if "gate_$g"; then
        echo "G$g: PASS"
    fi

    echo
done

if [ "$ran" = 0 ]; then
    echo "no gates matched '$GATES'" >&2
    exit 2
fi

echo "logs: $LOGDIR"

if [ "$FAILED" != 0 ]; then
    echo "one or more gates FAILED"
    exit 1
fi

echo "all selected gates PASSED"
