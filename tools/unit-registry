# Indexing
# --------------------------------------------------------------------------

def walk_sources(root: str, errors: list):
    for d in SCAN_ROOTS:
        base = os.path.join(root, d)
        if not os.path.isdir(base):
            continue
        # os.walk skips a directory it cannot list without a word.
        for dirpath, dirnames, filenames in os.walk(
                base, onerror=lambda e: errors.append(
                    unreadable_msg(root, e))):
            dirnames[:] = [x for x in dirnames if x not in SKIP_DIRS]
            for f in sorted(filenames):
                if f.endswith(C_EXT):
                    p = os.path.join(dirpath, f)
                    yield os.path.relpath(p, root), p


# Every artifact `index` writes, with its columns. verify requires all of them:
# a missing public_abi.tsv silently stopped `dead` withholding the public ABI,
# which is the to-delete direction.
ARTIFACT_COLUMNS = {
    "functions.tsv": ["symbol", "kind", "file", "line", "end_line", "storage",
                      "col1", "form", "context", "signature"],
    "usage.tsv": ["symbol", "file", "line", "col", "context", "kind",
                  "enclosing"],
    "objects.tsv": ["name", "kind", "file", "line", "storage", "context",
                    "text"],
    "constants.tsv": ["name", "kind", "file", "line", "context", "value"],
    "includes.tsv": ["file", "includes", "origin", "bracket", "context"],
    "abi.tsv": ["symbol", "abi", "declared_at", "nm_type", "nm_artifact",
                "prod_uses", "total_uses", "verdict"],
    "public_abi.tsv": ["symbol", "header"],
    "coverage.tsv": ["file", "context", "lines", "code_lines", "defs",
                     "decls", "objs", "attributed", "unaccounted",
                     "first_unaccounted", "final_depth", "cond_conflicts"],
    "disagreements.tsv": ["file", "scanner_defs", "astgrep_defs",
                          "only_scanner", "only_astgrep"],
}


# Go comments and literals (blanked, newlines kept) and a cgo reference.
GO_NOISE = re.compile(r'//[^\n]*|/\*.*?\*/|"(?:\\.|[^"\\\n])*"|`[^`]*`'
                      r"|'(?:\\.|[^'\\\n])*'", re.S)
GO_C_REF = re.compile(r"(?<![\w.])C\.([A-Za-z_]\w*)")


def index_go(root: str, known: set):
    """`C.name` references from go/*.go: (rel, rows, lines) per file.

    Only names the C index already registered are recorded, as calls when
    followed by `(` and as refs otherwise (`C.nxt_unit_ctx_t`). No Go parser:
    a cgo reference is lexically unambiguous once comments and strings are out.
    """
    base = os.path.join(root, "go")
    if not os.path.isdir(base):
        return
    # go/ is a scan root: walk_sources() reports a directory it cannot read.
    for dirpath, dirnames, filenames in os.walk(base):
        dirnames[:] = sorted(x for x in dirnames if x not in SKIP_DIRS)
        for f in sorted(filenames):
            if not f.endswith(".go"):
                continue
            path = os.path.join(dirpath, f)
            rel = os.path.relpath(path, root)
            try:
                with open(path, "r", errors="replace") as fh:
                    text = fh.read()
            except OSError as e:
                yield rel, None, e
                continue
            code = GO_NOISE.sub(lambda m: re.sub(r"[^\n]", " ", m.group(0)),
                                text)
            rows = []
            for m in GO_C_REF.finditer(code):
                name = m.group(1)
                if name not in known:
                    continue
                line = code.count("\n", 0, m.start()) + 1
                col = m.start() - (code.rfind("\n", 0, m.start()) + 1) + 1
                rest = code[m.end():].lstrip(" \t")
                rows.append((name, line, col,
                             "call" if rest.startswith("(") else "ref", "-"))
            yield rel, rows, text.count("\n")


def tsv(fields):
    return "\t".join(
        str(f).replace("\t", " ").replace("\n", " ").replace("\r", " ")
        for f in fields)


# The include roots the build puts on -I. Unit includes its OWN headers with
# angle brackets (`#include <nxt_main.h>` at src/nxt_conf.c:8), so bracket style
# says nothing about whether a header is in-tree: resolving the path against
# the tree is the only test that works. Getting this backwards labelled 912 of
# the tree's 1016 include edges "system", the great majority of them wrong.
INCLUDE_ROOTS = ("src", "src/test", "test", "fuzzing", ".")


def resolve_include(rel_from: str, inc: str, all_files: set):
    """Resolve an #include against the tree. In-tree iff the file is there."""
    cand = os.path.normpath(os.path.join(os.path.dirname(rel_from), inc))
    if cand in all_files:
        return cand, "intree"
    for d in INCLUDE_ROOTS:
        cand = os.path.normpath(os.path.join(d, inc))
        if cand in all_files:
            return cand, "intree"
    return inc, "system"


def do_index(args):
    t0 = time.time()
    src_root = os.path.abspath(args.src)
    if not os.path.isdir(src_root):
        die("--src %s is not a directory" % args.src)
    # An explicit --build that cannot be read would leave the ABI half empty
    # with the index still green, and `abi` would then ask for --build.
    if args.build_is_explicit:
        if not os.path.isdir(args.build):
            die("--build %s is not a directory" % args.build)
        if shutil.which("nm") is None:
            die("--build needs nm on PATH (binutils); it was not found")
        if not nm_targets(args.build):
            die("--build %s holds no sbin/unitd, lib/libunit.a, lib/libnxt.a "
                "or module .so; build it first, or index with --no-build"
                % args.build)

    if not args.ref:
        try:
            top = git(src_root, "rev-parse", "--show-toplevel").strip()
            # A tree inside some other repository is not that repository.
            sha = (git(src_root, "rev-parse", "HEAD").strip()
                   if os.path.realpath(top) == os.path.realpath(src_root)
                   else "unknown")
        except SystemExit:
            sha = "unknown"
        return _index(args, t0, src_root, src_root, "<worktree>", sha)

    # A ref that starts with `-` would reach git as an option.
    if args.ref.startswith("-"):
        die("refusing --ref %r: a ref cannot start with '-'" % args.ref)
    sha = git(src_root, "rev-parse", "--verify",
              args.ref + "^{commit}").strip()
    tmpdir = tempfile.mkdtemp(prefix="unit-registry-")
    # Removed on every exit, die() included: die() raises SystemExit.
    try:
        tar = subprocess.run(["git", "-C", src_root, "archive", sha],
                             capture_output=True, timeout=300)
        if tar.returncode != 0:
            die("git archive %s failed: %s"
                % (args.ref, tar.stderr.decode()[:300]))
        p = subprocess.run(["tar", "-x", "-C", tmpdir], input=tar.stdout,
                           capture_output=True, timeout=300)
        if p.returncode != 0:
            die("tar extract failed: %s" % p.stderr.decode()[:300])
        return _index(args, t0, src_root, tmpdir, args.ref, sha)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def _index(args, t0, src_root, root, ref, sha):
    out_dir = os.path.abspath(args.out)
    os.makedirs(out_dir, exist_ok=True)

    # Everything that could not be read; each one is a gate failure.
    unreadable = []
    cls = Classifier(root, unreadable)
    public_headers = read_public_headers(root, unreadable)
    files = list(walk_sources(root, unreadable))
    if not files:
        die("no C sources under %s (%s). Is that a FreeUnit tree?%s"
            % (root, ", ".join(SCAN_ROOTS),
               "".join("\n  " + u for u in unreadable)))
    all_rel = {rel for rel, _ in files}

    parsed = {}
    cxx_files = set()
    fn_defs, fn_decls, consts, top_objs = [], [], [], []
    includes_rows = []
    cov_rows = []
    known = set()
    alt_defs = 0
    hidden = []

    # ---- pass 1: parse, functions, constants, includes
    for rel, path in files:
        try:
            with open(path, "r", errors="replace") as fh:
                src = fh.read()
        except OSError as e:
            # A gate failure, not a warning: a skipped file takes its
            # references with it, and `dead` then lists the functions only it
            # called as deletion candidates.
            unreadable.append(unreadable_msg(
                root, e, "its definitions and references are missing from "
                "the index"))
            continue
        mk = mask(rel, src)
        if is_cxx(mk.code):
            # Not C. Parsing it fed names like `status` into the symbol table
            # and left nxt_napi.h unbalanced, and neither this scanner nor a C
            # grammar says anything trustworthy about it.
            cxx_files.add(rel)
            continue
        defs, decls, objs, aggs, spans, final_depth = scan_top_level(mk)
        alt = alternative_defs(mk, defs) if mk.cond_conflicts else []
        alt_defs += len(alt)
        dconsts, dincludes = extract_directives(mk)
        econsts = extract_enums(mk, aggs)
        parsed[rel] = (mk, defs + alt, decls, objs, econsts, aggs)

        ctx = cls.context(rel)
        for d in defs + alt:
            form = ("macro-arg" if d.macro == "macro-arg"
                    else "macro" if d.macro else "-")
            fn_defs.append((d.name, rel, d.line, d.end_line, d.storage,
                            "yes" if d.col1 else "no", form, ctx,
                            d.signature))
            known.add(d.name)
        for d in decls:
            fn_decls.append((d.name, rel, d.line, d.storage, ctx, d.signature))
            known.add(d.name)
        for name, kind, line, value in dconsts + econsts:
            consts.append((name, kind, rel, line, ctx, value))
            known.add(name)
        for inc, bracket in dincludes:
            target, where = resolve_include(rel, inc, all_rel)
            includes_rows.append((rel, target, where, bracket, ctx))

        for o in objs:
            top_objs.append((o.name, o.kind, rel, o.line, o.storage, ctx,
                             o.text))
            known.add(o.name)
        cov_rows.append((rel, ctx, coverage(mk, defs, decls, objs, aggs, spans,
                                            final_depth)))

    # ---- pass 2: usage
    usage_rows = []
    pp_names = {c[0] for c in consts}
    code_names = ({d[0] for d in fn_defs} | {d[0] for d in fn_decls}
                  | {o[0] for o in top_objs})
    for rel, (mk, defs, decls, objs, enums, aggs) in parsed.items():
        ctx = cls.context(rel)
        for name, line, col, kind, encl in index_usage(
                mk, defs, decls, objs, enums, known, aggs, pp_names,
                code_names):
            usage_rows.append((name, rel, line, col, ctx, kind, encl))

    # ---- Go callers of the C side, as module-context references
    go_files = 0
    for rel, rows, info in index_go(root, known):
        if rows is None:
            unreadable.append(unreadable_msg(
                root, info, "its references are missing from the index"))
            continue
        go_files += 1
        ctx = cls.context(rel)
        for name, line, col, kind, encl in rows:
            usage_rows.append((name, rel, line, col, ctx, kind, encl))
        cov_rows.append((rel, ctx, {
            "lines": info, "code_lines": 0, "defs": 0, "decls": 0, "objs": 0,
            "attributed": info, "unaccounted": 0, "first_unaccounted": 0,
            "final_depth": 0, "cond_conflicts": 0}))

    # ---- gates
    failures, findings = list(unreadable), []
    for rel in sorted(cxx_files):
        if rel.endswith(".c"):
            failures.append("cxx: %s reads as C++ and was not indexed; a .c "
                            "file is C, so its definitions and references "
                            "would be missing" % rel)

    for rel, ctx, c in cov_rows:
        # A file whose braces do not close is the runaway-body failure: one
        # definition swallows the rest of the translation unit and the line
        # accounting still looks perfect. Gate on the depth, not the symptom.
        if c["final_depth"] != 0:
            failures.append("balance: %s ends at brace depth %d: some "
                            "definition has swallowed the rest of the file"
                            % (rel, c["final_depth"]))
        if (rel.endswith(".c") and c["defs"] == 0
                and c["code_lines"] >= MIN_CODE_LINES):
            failures.append("coverage: %s has %d code lines and zero function "
                            "definitions" % (rel, c["code_lines"]))
        if c["lines"] and c["unaccounted"] / c["lines"] > MAX_UNACCOUNTED:
            failures.append("coverage: %s leaves %d/%d lines unattributed "
                            "(first at line %d)"
                            % (rel, c["unaccounted"], c["lines"],
                               c["first_unaccounted"]))

    astgrep = args.astgrep or shutil.which("ast-grep") \
        or os.path.expanduser("~/.local/bin/ast-grep")
    xcheck_ok = False
    if args.crosscheck and os.path.exists(astgrep):
        ag, xcheck_ok = crosscheck_astgrep(root, files, astgrep)
        if not xcheck_ok:
            failures.append(
                "crosscheck: ast-grep returned an empty result set for the "
                "whole tree. That is a broken cross-check, not agreement: "
                "re-run with --no-crosscheck only if you accept an unverified "
                "index.")
        else:
            mine = defaultdict(set)
            for name, rel, *_ in fn_defs:
                mine[rel].add(name)
            conflicted = {rel for rel, _ctx, c in cov_rows
                          if c["cond_conflicts"]}
            for rel in sorted(set(mine) | set(ag)):
                if not rel.endswith(".c") and not rel.endswith(".h"):
                    continue
                if rel in cxx_files:
                    continue
                a, b = mine.get(rel, set()), ag.get(rel, set())
                only_mine, only_ag = sorted(a - b), sorted(b - a)
                if only_mine or only_ag:
                    findings.append(
                        (rel, len(a), len(b),
                         ",".join(only_mine[:8]) or "-",
                         ",".join(only_ag[:8]) or "-"))
                # Recording a disagreement is not enough. A mutated nxt_router.c
                # that lost 105 of its 106 definitions produced "1 vs 106" here
                # and still exited 0, because nothing ast-grep found could ever
                # fail the run. A shortfall this large is the truncation this
                # tool exists to catch.
                # Where an #if/#else straddles a brace, alternative_defs()
                # has already read the other branches. A definition ast-grep
                # still finds there is reported, not fatal: it is one
                # definition in a conditional the scanner cannot resolve,
                # not a truncated file. The shortfall checks below still
                # apply to such a file.
                if only_ag and rel in conflicted:
                    hidden.append("%s (%s)" % (rel, ", ".join(only_ag[:6])))
                if len(b) >= 4 and len(a) < len(b) * 0.5:
                    failures.append(
                        "crosscheck: %s: scanner found %d definitions, "
                        "ast-grep found %d (missing: %s)"
                        % (rel, len(a), len(b),
                           ", ".join(only_ag[:6]) or "?"))
                elif len(only_ag) >= 10:
                    failures.append(
                        "crosscheck: %s: ast-grep found %d definitions the "
                        "scanner missed (%s)"
                        % (rel, len(only_ag), ", ".join(only_ag[:6])))
    elif args.crosscheck:
        failures.append("crosscheck: ast-grep not found at %s" % astgrep)

    # column-1 disagreement is a finding, never a silent choice
    col1_bad = [(n, f, l) for (n, f, l, _e, _s, c1, mac, _c, _sig)
                in fn_defs if c1 == "no" and mac == "-"]

    # ---- ABI
    abi_rows = []
    nm_syms = {}
    build_dir = args.build or os.path.join(src_root, "build")
    # A binary built from the working tree says nothing about a different ref,
    # and scoring one against the other produces confident nonsense in every
    # abi.tsv verdict. Refuse rather than mislabel.
    if (args.ref and not args.build_is_explicit) or args.no_build:
        build_dir = None
    if build_dir and os.path.isdir(build_dir):
        nm_syms = read_nm(build_dir)

    public_abi = {name for name, rel, _l, _s, _c, _sig in fn_decls
                  if rel in public_headers}

    declared_export = {}
    for name, rel, line, storage, ctx, sig in fn_decls:
        if storage == "NXT_EXPORT":
            declared_export.setdefault(name, (rel, line))
    for name, rel, line, _e, storage, _c1, _m, ctx, sig in fn_defs:
        if storage == "NXT_EXPORT":
            declared_export.setdefault(name, (rel, line))

    call_count = defaultdict(lambda: defaultdict(int))
    for name, rel, line, col, ctx, kind, encl in usage_rows:
        call_count[name][ctx] += 1

    defined_names = {n for n, *_ in fn_defs}
    seen_abi = set()
    for name in sorted(set(declared_export) | set(nm_syms)):
        if name in seen_abi:
            continue
        seen_abi.add(name)
        decl_site = declared_export.get(name)
        in_nm = nm_syms.get(name)
        uses = call_count.get(name, {})
        prod = uses.get(CTX_PROD, 0)
        total_uses = sum(uses.values())
        verdict = []
        if decl_site and not in_nm and nm_syms:
            verdict.append("declared-not-in-binary")
        if in_nm and not decl_site and name in defined_names:
            verdict.append("in-binary-not-declared")
        if decl_site and total_uses == 0:
            verdict.append("exported-never-referenced")
        if in_nm and total_uses == 0 and name not in defined_names:
            verdict.append("binary-only-unreferenced")
        if in_nm and total_uses == 0 and name in defined_names:
            verdict.append("in-binary-unreferenced")
        if decl_site and prod == 0 and total_uses > 0:
            verdict.append("exported-no-production-caller")
        abi_rows.append((
            name,
            "public" if name in public_abi else "-",
            "%s:%d" % decl_site if decl_site else "-",
            in_nm[0] if in_nm else "-",
            in_nm[1] if in_nm else "-",
            prod, total_uses,
            ",".join(verdict) or "agree"))

    # ---- write artifacts
    def write(fn, rows):
        p = os.path.join(out_dir, fn)
        with open(p, "w") as fh:
            fh.write("#" + tsv(ARTIFACT_COLUMNS[fn]) + "\n")
            for r in rows:
                fh.write(tsv(r) + "\n")
        return os.path.getsize(p)

    sizes = {}
    sizes["functions.tsv"] = write(
        "functions.tsv",
        sorted([(n, "def", f, l, e, s, c1, m, c, sig)
                for (n, f, l, e, s, c1, m, c, sig) in fn_defs] +
               [(n, "decl", f, l, "", s, "", "-", c, sig)
                for (n, f, l, s, c, sig) in fn_decls],
               key=lambda r: (r[0], r[2], r[3])))
    sizes["usage.tsv"] = write(
        "usage.tsv",
        sorted(usage_rows, key=lambda r: (r[0], r[1], r[2])))
    sizes["objects.tsv"] = write(
        "objects.tsv",
        sorted(top_objs, key=lambda r: (r[0], r[2], r[3])))
    sizes["constants.tsv"] = write(
        "constants.tsv",
        sorted(consts, key=lambda r: (r[0], r[2], r[3])))
    sizes["includes.tsv"] = write(
        "includes.tsv",
        sorted(set(includes_rows)))
    sizes["abi.tsv"] = write(
        "abi.tsv",
        abi_rows)
    sizes["public_abi.tsv"] = write(
        "public_abi.tsv",
        sorted((n, r) for n, r, _l, _s, _c, _sig in fn_decls
               if r in public_headers))
    sizes["coverage.tsv"] = write(
        "coverage.tsv",
        [(rel, ctx, c["lines"], c["code_lines"], c["defs"], c["decls"],
          c["objs"], c["attributed"], c["unaccounted"],
          c["first_unaccounted"], c["final_depth"], c["cond_conflicts"])
         for rel, ctx, c in sorted(cov_rows)])
    sizes["disagreements.tsv"] = write(
        "disagreements.tsv",
        sorted(findings))

    elapsed = time.time() - t0
    ctx_counts = defaultdict(int)
    for r in usage_rows:
        ctx_counts[r[4]] += 1

    manifest = [
        "# unit-registry MANIFEST",
        "schema\t%s" % SCHEMA,
        "tool_version\t%s" % VERSION,
        "generated\t%s" % time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "source_root\t%s" % src_root,
        "ref\t%s" % ref,
        "sha\t%s" % sha,
        "build_dir\t%s" % (build_dir if nm_syms else "-"),
        # Never "yes": nothing here shows the build came from this tree.
        "build_matches_ref\t%s" % ("n/a" if not nm_syms else "assumed"),
        "nm_symbols\t%d" % len(nm_syms),
        "files\t%d" % len(files),
        "c_files\t%d" % sum(1 for r, _c, _v in cov_rows if r.endswith(".c")),
        "header_files\t%d" % sum(1 for r, _c, _v in cov_rows
                                 if r.endswith(".h")),
        "function_defs\t%d" % len(fn_defs),
        "function_decls\t%d" % len(fn_decls),
        "constants\t%d" % len(consts),
        "top_level_objects\t%d" % len(top_objs),
        "unbalanced_files\t%d" % sum(
            1 for _r, _c, c in cov_rows if c["final_depth"] != 0),
        "conditional_conflicts\t%d" % sum(
            c["cond_conflicts"] for _r, _c, c in cov_rows),
        "conditional_alt_defs\t%d" % alt_defs,
        "conditional_hidden_files\t%d" % len(hidden),
        "unattributed_lines\t%d" % sum(
            c["unaccounted"] for _r, _c, c in cov_rows),
        "usage_rows\t%d" % len(usage_rows),
        "include_edges\t%d" % len(set(includes_rows)),
        "index_seconds\t%.2f" % elapsed,
        "crosscheck\t%s" % ("ast-grep" if xcheck_ok else "NONE"),
        "crosscheck_disagreements\t%d" % len(findings),
        "col1_outliers\t%d" % len(col1_bad),
        "public_headers\t%d" % len(public_headers),
        "public_abi_symbols\t%d" % len(public_abi),
        "cxx_files_excluded\t%d" % len(cxx_files),
        "cxx_files\t%s" % (",".join(sorted(cxx_files)) or "-"),
        "go_files\t%d" % go_files,
        "gate_failures\t%d" % len(failures),
    ]
    for c in CONTEXT_ORDER:
        manifest.append("usage_%s\t%d" % (c, ctx_counts.get(c, 0)))
    with open(os.path.join(out_dir, "MANIFEST"), "w") as fh:
        fh.write("\n".join(manifest) + "\n")

    # ---- report
    print("indexed %s (%s) in %.2fs" % (ref, sha[:12], elapsed))
    print("  %d files, %d defs, %d decls, %d objects, %d constants, "
          "%d usage rows"
          % (len(files), len(fn_defs), len(fn_decls), len(top_objs),
             len(consts), len(usage_rows)))
    tot_lines = sum(c["lines"] for _r, _c, c in cov_rows)
    tot_un = sum(c["unaccounted"] for _r, _c, c in cov_rows)
    print("  line accounting: %d/%d attributed (%.2f%% unaccounted)"
          % (tot_lines - tot_un, tot_lines,
             100.0 * tot_un / tot_lines if tot_lines else 0.0))
    print("  usage by context: " + "  ".join(
        "%s=%d" % (c, ctx_counts.get(c, 0)) for c in CONTEXT_ORDER))
    print("  artifacts in %s" % out_dir)
    for k in sorted(sizes):
        print("    %-20s %8.1f KiB" % (k, sizes[k] / 1024.0))
    print("  cross-check: %s" % ("ast-grep, %d file(s) disagree" % len(findings)
                                 if xcheck_ok
                                 else "NONE, see gate failures"
                                 if args.crosscheck
                                 else "NONE, cross-check disabled"))
    if alt_defs:
        print("  read from another #if branch: %d definition(s)" % alt_defs)
    if hidden:
        print("  not indexed, hidden by an #if/#else around a brace "
              "(see disagreements.tsv): %s" % "; ".join(hidden[:6]))
    if col1_bad:
        print("  column-1 outliers: %d (e.g. %s)"
              % (len(col1_bad), ", ".join("%s %s:%d" % x for x in col1_bad[:3])))
    if failures:
        print("\nGATE FAILURES (%d):" % len(failures))
        for f in failures[:40]:
            print("  ! " + f)
        if len(failures) > 40:
            print("  ... and %d more" % (len(failures) - 40))
        print("\nThe artifacts are written for inspection, but every query "
              "except `stat` refuses this registry until an index passes.")
        return 1
    print("\ngates: OK")
    return 0


