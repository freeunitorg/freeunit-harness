class Registry:
    def __init__(self, d, allow_failed=False):
        self.dir = d
        man = os.path.join(d, "MANIFEST")
        if not os.path.exists(man):
            die("no registry at %s. Run: unit-registry index" % d)
        self.manifest = {}
        for line in open(man):
            if line.startswith("#") or "\t" not in line:
                continue
            k, v = line.rstrip("\n").split("\t", 1)
            self.manifest[k] = v
        if self.manifest.get("schema") != SCHEMA:
            die("registry at %s has schema %s, this tool speaks %s. Re-index"
                % (d, self.manifest.get("schema"), SCHEMA))
        # An index whose gates failed has artifacts that are known to be
        # wrong somewhere. Answering from them is the confidently-wrong case
        # the gates exist to prevent.
        gf = self.manifest.get("gate_failures")
        if gf != "0" and not allow_failed:
            die("registry at %s was written by an index whose gates failed "
                "(gate_failures=%s). Fix the cause and re-index; "
                "`unit-registry stat` shows the MANIFEST" % (d, gf or "?"))

    def rows(self, name):
        p = os.path.join(self.dir, name)
        if not os.path.exists(p):
            # Answering without it is answering from part of the index.
            die("registry at %s has no %s. Re-index" % (self.dir, name))
        with open(p) as fh:
            head = fh.readline().lstrip("#").rstrip("\n").split("\t")
            for line in fh:
                if not line.strip():
                    continue
                yield dict(zip(head, line.rstrip("\n").split("\t")))

    def all_symbols(self):
        names = set()
        for fn, col in (("functions.tsv", "symbol"), ("constants.tsv", "name"),
                        ("objects.tsv", "name")):
            for r in self.rows(fn):
                names.add(r[col])
        return names

    def ref(self):
        return "%s (%s)" % (self.manifest.get("ref", "?"),
                            self.manifest.get("sha", "?")[:12])


def unregistered(what, name,
                 hint="Check the spelling, or it may be macro-generated."):
    """Exit status 2 for a name the registry does not know.

    Otherwise a typo answers "no callers" or "no uses" in the same words as a
    real result, which is the most dangerous wrong answer this tool can give.
    """
    sys.stderr.write("unit-registry: %r is not in this registry: no %s of "
                     "that name was indexed at this ref. %s\n"
                     % (name, what, hint))
    return 2


def cmd_defs(reg, args):
    print("# %s" % reg.ref())
    n = 0
    for r in reg.rows("functions.tsv"):
        if r["symbol"] != args.symbol:
            continue
        n += 1
        print("%-5s %-9s %s:%s  %s"
              % (r["kind"], r["storage"], r["file"], r["line"], r["signature"]))
    if not n:
        return unregistered("function definition or declaration", args.symbol)
    return 0


def cmd_uses(reg, args):
    print("# %s" % reg.ref())
    if args.symbol not in reg.all_symbols():
        return unregistered("definition, declaration, constant or object",
                            args.symbol)
    by_ctx = defaultdict(list)
    for r in reg.rows("usage.tsv"):
        if r["symbol"] != args.symbol:
            continue
        by_ctx[r["context"]].append(r)
    site = {}
    for r in reg.rows("functions.tsv"):
        if r["symbol"] == args.symbol:
            site.setdefault(r["kind"], "%s:%s" % (r["file"], r["line"]))
    if site:
        print("defined: %s" % site.get("def", "-"),
              " declared:", site.get("decl", "-"))
    total = sum(len(v) for v in by_ctx.values())
    print("references: %d  (%s)" % (
        total, "  ".join("%s=%d" % (c, len(by_ctx.get(c, [])))
                         for c in CONTEXT_ORDER)))
    if total == 0:
        print("\nNO REFERENCES ANYWHERE: dead in this ref.")
        return 0
    if not by_ctx.get(CTX_PROD):
        print("\nNO PRODUCTION CALLER: reachable only from %s."
              % ", ".join(sorted(c for c in by_ctx)))
    for c in CONTEXT_ORDER:
        rs = by_ctx.get(c)
        if not rs:
            continue
        if args.context and args.context != c:
            continue
        print("\n[%s]" % c)
        for r in sorted(rs, key=lambda r: (r["file"], int(r["line"]))):
            print("  %s:%s  %-5s in %s"
                  % (r["file"], r["line"], r["kind"], r["enclosing"]))
    return 0


def _call_edges(reg):
    """caller -> set(callee) and callee -> set((caller, file, line, ctx))."""
    fwd, rev = defaultdict(set), defaultdict(set)
    for r in reg.rows("usage.tsv"):
        if r["kind"] != "call":
            continue
        fwd[r["enclosing"]].add(r["symbol"])
        rev[r["symbol"]].add((r["enclosing"], r["file"], r["line"],
                              r["context"]))
    return fwd, rev


def _addr_refs(reg):
    """callee -> set((enclosing, file, line, ctx)) for every non-call reference.

    For a function that is `&fn` or a bare `fn` stored in a pointer: the
    function is reachable from wherever the pointer is dispatched, which the
    call graph cannot see.
    """
    refs = defaultdict(set)
    for r in reg.rows("usage.tsv"):
        if r["kind"] == "ref":
            refs[r["symbol"]].add((r["enclosing"], r["file"], r["line"],
                                   r["context"]))
    return refs


def _by_site(rows):
    return sorted(rows, key=lambda t: (t[1], int(t[2])))


ADDR_TAKEN = "address-taken (not a direct call):"


def cmd_callers(reg, args):
    print("# %s" % reg.ref())
    if args.symbol not in reg.all_symbols():
        return unregistered("definition, declaration, constant or object",
                            args.symbol)
    _fwd, rev = _call_edges(reg)
    addr = _addr_refs(reg)
    home = None
    for r in reg.rows("functions.tsv"):
        if r["symbol"] == args.symbol and r["kind"] == "def":
            home = r["file"]
            break
    if not args.transitive:
        rs = _by_site(rev.get(args.symbol, ()))
        taken = _by_site(addr.get(args.symbol, ()))
        if not rs and not taken:
            print("no callers of %s" % args.symbol)
            return 0
        for encl, f, l, ctx in rs:
            print("  %s:%s  [%s]  in %s" % (f, l, ctx, encl))
        if taken:
            print("%s%s" % ("\n" if rs else "", ADDR_TAKEN))
            for encl, f, l, ctx in taken:
                print("  %s:%s  [%s]  in %s" % (f, l, ctx, encl))
        return 0

    # BFS up the call graph. With --external, stop expanding as soon as a
    # caller lives outside the defining file: those are the entry points.
    seen = {args.symbol}
    frontier = [args.symbol]
    depth = 0
    external = []
    while frontier and depth < args.max_depth:
        edges = [(sym, e) for sym in frontier
                 for e in _by_site(rev.get(sym, ()))]
        if not edges:
            break
        depth += 1
        nxt = []
        print("\n-- depth %d --" % depth)
        for sym, (encl, f, l, ctx) in edges:
            print("  %s:%s  [%s]  %s -> %s" % (f, l, ctx, encl, sym))
            if args.external and home is not None and f != home:
                external.append((f, l, ctx, encl))
                continue
            if encl != "-" and encl not in seen:
                seen.add(encl)
                nxt.append(encl)
        frontier = nxt
    if args.external:
        print("\ncall sites outside %s: %d" % (home, len(external)))
        for f, l, ctx, encl in sorted(external, key=lambda t: (t[0], int(t[1]))):
            print("  %s:%s  [%s]  in %s" % (f, l, ctx, encl))
    # The walk follows call edges only. A function on it that is also stored
    # in a pointer is reached through that pointer too; say so, with the count.
    taken = sorted(((f, l, ctx, encl, sym) for sym in seen
                    for encl, f, l, ctx in addr.get(sym, ())),
                   key=lambda t: (t[0], int(t[1]), t[4]))
    print("\naddress-taken references not followed: %d" % len(taken))
    for f, l, ctx, encl, sym in taken:
        print("  %s:%s  [%s]  %s taken in %s" % (f, l, ctx, sym, encl))
    return 0


def cmd_dead(reg, args):
    print("# %s" % reg.ref())
    public = {r["symbol"]: r["header"] for r in reg.rows("public_abi.tsv")}
    # A form=macro row with a macro-arg row on its line is the invocation
    # (PHP_FUNCTION, XS), whose function is the macro-arg row; the macro
    # itself is not a function. Without that pair, form=macro only means
    # an all-caps name, as for NXT_CMSG_NXTHDR, which is a real function.
    defs = [r for r in reg.rows("functions.tsv") if r["kind"] == "def"]
    invoked = {(r["file"], r["line"]) for r in defs
               if r["form"] == "macro-arg"}
    defs = [r for r in defs if r["form"] != "macro"
            or (r["file"], r["line"]) not in invoked]
    # A static in a .c file is visible only in that file, so it owns that
    # file's references to its name and none from anywhere else. Without this
    # a dead static is hidden by any same-named function elsewhere that is
    # live. Header statics (nxt_inline) stay matched by bare name.
    file_static = {(r["file"], r["symbol"]) for r in defs
                   if r["storage"] == "static" and r["file"].endswith(".c")}
    uses = defaultdict(lambda: defaultdict(int))
    for r in reg.rows("usage.tsv"):
        key = r["symbol"]
        if (r["file"], key) in file_static:
            key = (r["file"], key)
        uses[key][r["context"]] += 1
    rows = []
    for r in defs:
        if args.file_prefix and not r["file"].startswith(args.file_prefix):
            continue
        key = r["symbol"]
        if (r["file"], key) in file_static:
            key = (r["file"], key)
        u = uses.get(key, {})
        prod = u.get(CTX_PROD, 0) + u.get(CTX_MODULE, 0)
        total = sum(u.values())
        if args.mode == "everywhere" and total == 0:
            rows.append((r, 0, 0))
        elif args.mode == "production" and prod == 0 and r["context"] == CTX_PROD:
            rows.append((r, prod, total))

    # libunit is a shipped library: a symbol declared in an installed header
    # has consumers this tree cannot see, so "no references here" is not a
    # deletion candidate. Withheld by default rather than merely annotated,
    # because this list is read as a to-delete list.
    withheld = [t for t in rows if t[0]["symbol"] in public]
    if not args.include_public:
        rows = [t for t in rows if t[0]["symbol"] not in public]

    print("%d symbol(s) with no %sreference\n"
          % (len(rows), "" if args.mode == "everywhere" else "production "))
    for r, prod, total in sorted(rows, key=lambda t: (t[0]["file"],
                                                      int(t[0]["line"]))):
        key = r["symbol"]
        if (r["file"], key) in file_static:
            key = (r["file"], key)
        u = uses.get(key, {})
        where = "  ".join("%s=%d" % (c, u[c]) for c in CONTEXT_ORDER if u.get(c))
        tag = "  [PUBLIC ABI %s]" % public[r["symbol"]] \
            if r["symbol"] in public else ""
        print("  %-40s %s:%s  %-10s %s%s"
              % (r["symbol"], r["file"], r["line"], r["storage"],
                 where or "no references", tag))
    if withheld and not args.include_public:
        print("\n%d further symbol(s) have no in-tree reference but are "
              "declared in an installed libunit header, so external code "
              "links them: NOT deletion candidates. Show with "
              "--include-public." % len(withheld))
    print("\nApproximate: references resolve by name (statics in .c files "
          "are scoped to their file), and calls through function pointers, "
          "token pasting or code outside the tree are not seen. Confirm each "
          "candidate by reading it before deleting.")
    return 0


def cmd_abi(reg, args):
    print("# %s" % reg.ref())
    if reg.manifest.get("nm_symbols", "0") == "0":
        print("no built artifacts were indexed; the 'actual' side of the ABI "
              "registry is empty. Re-index with --build <dir>.")
    groups = defaultdict(list)
    for r in reg.rows("abi.tsv"):
        for v in r["verdict"].split(","):
            groups[v].append(r)
    for v in sorted(groups):
        if args.verdict:
