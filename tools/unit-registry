# ABI: declared (NXT_EXPORT) vs actual (nm)
# --------------------------------------------------------------------------

NM_RE = re.compile(r"^([0-9a-fA-F]*)\s+([A-Za-z])\s+(\S+)$")


def nm_targets(build_dir: str):
    """The artifacts read_nm() reads, each with its nm options."""
    targets = []
    for cand in ("sbin/unitd", "lib/libunit.a", "lib/libnxt.a"):
        p = os.path.join(build_dir, cand)
        if os.path.exists(p):
            targets.append((p, ["--defined-only", "--extern-only"]))
    for root_, _dirs, files in os.walk(build_dir):
        for f in sorted(files):
            if f.endswith(".so"):
                targets.append((os.path.join(root_, f),
                                ["--defined-only", "--extern-only",
                                 "--dynamic"]))
    return targets


def read_nm(build_dir: str):
    """Symbols the built artifacts export: global binding only.

    A local symbol (nm type t/d/r/b: a static function, a string table, a
    compiler label such as __func__.0) is not an export, and counting them
    made most of abi.tsv about symbols nothing can link. libnxt.a holds the
    NXT_EXPORT core (nxt_thread_cond_create is in no other artifact), so it
    is read too. Module .so files are read through their dynamic table.
    """
    out = {}
    for t, opts in nm_targets(build_dir):
        try:
            proc = subprocess.run(["nm", *opts, t],
                                  capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.SubprocessError) as e:
            warn("nm %s failed: %s" % (t, e))
            continue
        if proc.returncode != 0:
            warn("nm %s exited %d: %s"
                 % (t, proc.returncode, proc.stderr.strip()[:200]))
        for line in proc.stdout.splitlines():
            m = NM_RE.match(line.strip())
            if not m:
                continue
            _addr, typ, name = m.groups()
            # Upper case is global binding; `u` is a GNU unique global.
            # Checked here as well, not left to the nm options alone.
            if not (typ.isupper() or typ == "u") or typ == "U":
                continue
            out.setdefault(name, (typ, os.path.basename(t)))
    return out


