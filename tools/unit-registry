def git(root, *args):
    p = subprocess.run(["git", "-C", root, *args], capture_output=True,
                       text=True, timeout=120)
    if p.returncode != 0:
        die("git %s failed: %s" % (" ".join(args), p.stderr.strip()[:300]))
    return p.stdout


def warn(msg):
    sys.stderr.write("unit-registry: %s\n" % msg)


def die(msg):
    sys.stderr.write("unit-registry: %s\n" % msg)
    sys.exit(2)


DEFAULT_SRC = os.environ.get(
    "UNIT_SRC", os.path.join(os.path.dirname(os.path.dirname(
        os.path.abspath(__file__))), "src"))
DEFAULT_OUT = os.environ.get(
    "UNIT_REGISTRY", os.path.join(os.path.dirname(os.path.dirname(
        os.path.abspath(__file__))), "run", "registry"))


def main(argv):
    p = argparse.ArgumentParser(
        prog="unit-registry",
        description="A greppable code registry for the FreeUnit C tree. "
                    "No database: the index is TSV you can rg, diff and read.",
        epilog="Artifacts land in $UNIT_REGISTRY (default run/registry/). "
               "Source tree from --src or $UNIT_SRC.")
    p.add_argument("--src", default=DEFAULT_SRC,
                   help="FreeUnit source tree (default: $UNIT_SRC)")
    p.add_argument("--registry", default=DEFAULT_OUT,
                   help="registry directory to read (default: $UNIT_REGISTRY)")
    sub = p.add_subparsers(dest="cmd")

    q = sub.add_parser("index", help="build the registry")
    q.add_argument("--ref", help="index this git ref instead of the working "
                                 "tree (e.g. origin/master)")
    q.add_argument("--out", default=None, help="output directory")
    b = q.add_mutually_exclusive_group()
    b.add_argument("--build", default=None,
                   help="build directory for the ABI side (default <src>/build)")
    b.add_argument("--no-build", action="store_true",
                   help="read no build directory; the ABI side stays empty")
    q.add_argument("--astgrep", default=None, help="path to ast-grep")
    q.add_argument("--no-crosscheck", dest="crosscheck", action="store_false",
                   help="skip the ast-grep cross-check (the index is then "
                        "unverified; say so if you report from it)")
    q.set_defaults(crosscheck=True)

    q = sub.add_parser("defs", help="where a symbol is defined and declared")
    q.add_argument("symbol")

    q = sub.add_parser("uses", help="every reference, split by context")
    q.add_argument("symbol")
    q.add_argument("--context", choices=CONTEXT_ORDER)

    q = sub.add_parser("callers", help="who calls a symbol")
    q.add_argument("symbol")
    q.add_argument("--transitive", action="store_true")
    q.add_argument("--external", action="store_true",
                   help="with --transitive, report the call sites outside the "
                        "defining file (the entry points)")
    q.add_argument("--max-depth", type=int, default=6)

    q = sub.add_parser("dead", help="definitions nothing references")
    q.add_argument("--mode", choices=("production", "everywhere"),
                   default="production")
    q.add_argument("--file-prefix", default=None)
    q.add_argument("--include-public", action="store_true",
                   help="also list symbols declared in installed libunit "
                        "headers (external code links these; they are not "
                        "deletion candidates)")

    q = sub.add_parser("abi", help="declared NXT_EXPORT vs what nm sees")
    q.add_argument("--verdict", choices=(
        "agree", "declared-not-in-binary", "in-binary-not-declared",
        "exported-never-referenced", "binary-only-unreferenced",
        "in-binary-unreferenced", "exported-no-production-caller"))
    q.add_argument("--all", action="store_true")
    q.add_argument("--limit", type=int, default=25)

    q = sub.add_parser("const", help="a #define or enum constant")
    q.add_argument("name")

    q = sub.add_parser("includes", help="the include graph around a file")
    q.add_argument("file")

    sub.add_parser("stat", help="what this registry is and when it was built")
    sub.add_parser("verify", help="the acceptance suite for the registry")

    args = p.parse_args(argv)
    if not args.cmd:
        p.print_help()
        return 0

    if args.cmd == "index":
        if args.out is None:
            args.out = args.registry
        args.build_is_explicit = args.build is not None
        return do_index(args)

    reg = Registry(args.registry, allow_failed=args.cmd == "stat")
    return {
        "defs": cmd_defs, "uses": cmd_uses, "callers": cmd_callers,
        "dead": cmd_dead, "abi": cmd_abi, "const": cmd_const,
        "includes": cmd_includes, "stat": cmd_stat, "verify": cmd_verify,
    }[args.cmd](reg, args)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        os._exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
