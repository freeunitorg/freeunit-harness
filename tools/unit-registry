        rs = groups[v]
        print("\n== %s (%d) ==" % (v, len(rs)))
        for r in sorted(rs, key=lambda r: r["symbol"])[:args.limit]:
            print("  %-44s declared=%-28s nm=%s/%s prod=%s total=%s"
                  % (r["symbol"], r["declared_at"], r["nm_type"],
                     r["nm_artifact"], r["prod_uses"], r["total_uses"]))
        if len(rs) > args.limit:
            print("  ... and %d more" % (len(rs) - args.limit))
    return 0


def cmd_const(reg, args):
    print("# %s" % reg.ref())
    found = False
    for r in reg.rows("constants.tsv"):
        if r["name"] != args.name:
            continue
        found = True
        print("%-11s %s:%s  %s" % (r["kind"], r["file"], r["line"], r["value"]))
    if not found:
        return unregistered("#define or enum constant", args.name)
    n = 0
    by_ctx = defaultdict(int)
    for r in reg.rows("usage.tsv"):
        if r["symbol"] != args.name:
            continue
        n += 1
        by_ctx[r["context"]] += 1
    print("uses: %d  (%s)" % (n, "  ".join("%s=%d" % (c, by_ctx.get(c, 0))
                                           for c in CONTEXT_ORDER)))
    return 0


def cmd_includes(reg, args):
    print("# %s" % reg.ref())
    fwd = [r for r in reg.rows("includes.tsv") if r["file"] == args.file]
    rev = [r for r in reg.rows("includes.tsv") if r["includes"] == args.file]
    if (not fwd and not rev
            and args.file not in {r["file"] for r in reg.rows("coverage.tsv")}):
        return unregistered("source file", args.file,
                            "Give the path relative to the source root, "
                            "e.g. src/nxt_conf.c.")
    print("\n%s includes:" % args.file)
    for r in sorted(fwd, key=lambda r: (r["origin"], r["includes"])):
        print("  %-9s %s" % (r["origin"], r["includes"]))
    print("\nincluded by (%d):" % len(rev))
    for r in sorted(rev, key=lambda r: r["file"]):
        print("  %-8s %s" % (r["context"], r["file"]))
    return 0


def cmd_stat(reg, args):
    for line in open(os.path.join(reg.dir, "MANIFEST")):
        sys.stdout.write(line)
    return 0


# --------------------------------------------------------------------------
# verify: the acceptance suite
#
# Two kinds of check, both re-derived from the artifacts alone.
#
# Invariants hold on any tree at any ref: if one fails, the registry is wrong.
#
# Tree checks pin hand-derived answers about specific FreeUnit symbols, each
# chosen because the registry once got it wrong in the "delete live code"
# direction. They are facts about a tree, not about the registry, so each one
# states what it needs (the symbol defined, the files indexed) and is SKIPPED
# with that reason at a ref where it is absent, rather than failed. Nothing
# keys on a ref or branch name. A FAIL on a tree check means the registry or
# the tree changed; the detail column says which sites it saw.
# --------------------------------------------------------------------------

def _artifact_problems(reg):
    bad = []
    for fn, cols in sorted(ARTIFACT_COLUMNS.items()):
        p = os.path.join(reg.dir, fn)
        try:
            with open(p) as fh:
                head = fh.readline().lstrip("#").rstrip("\n").split("\t")
        except OSError:
            bad.append("%s missing" % fn)
            continue
        if head != cols:
            bad.append("%s has columns %s" % (fn, head))
    return bad


def cmd_verify(reg, args):
    # Every later check reads these; with one gone they would pass on nothing.
    missing = _artifact_problems(reg)
    if missing:
        print("# %s\n" % reg.ref())
        print("FAIL  invariant: every artifact exists with its columns  %s"
              % "; ".join(missing))
        print("\n0 passed, 1 failed, 0 skipped")
        return 1

    uses = defaultdict(list)
    for r in reg.rows("usage.tsv"):
        uses[r["symbol"]].append(r)
    funcs = list(reg.rows("functions.tsv"))
    consts = list(reg.rows("constants.tsv"))
    cov = {r["file"]: r for r in reg.rows("coverage.tsv")}
    known = reg.all_symbols()

    def files_of(sym, ctxs=None):
        return sorted({r["file"] for r in uses.get(sym, ())
                       if ctxs is None or r["context"] in ctxs})

    results = []

    def check(name, ok, detail):
        results.append((name, ok, detail))

    def needs(sym, *files):
        """None if the check can run here, else the reason to skip it."""
        if sym not in known:
            return "skipped: %s not registered at this ref" % sym
        missing = [f for f in files if f not in cov]
        if missing:
            return "skipped: not indexed at this ref: %s" % ", ".join(missing)
        return None

    def tree_check(name, sym, files, fn):
        why = needs(sym, *files)
        if why:
            check(name, None, why)
        else:
            ok, detail = fn()
            check(name, ok, detail)

    # ---- invariants

    def first(bad):
        return "%d bad, e.g. %s" % (len(bad), bad[:3]) if bad else "ok"

    check("invariant: the index passed its gates",
          reg.manifest.get("gate_failures") == "0",
          "gate_failures=%s" % reg.manifest.get("gate_failures"))

    # An index built with --no-crosscheck has no gate failures and is still
    # unverified; the acceptance suite must not call it accepted.
    check("invariant: the index was cross-checked",
          reg.manifest.get("crosscheck") not in (None, "NONE"),
          "crosscheck=%s" % reg.manifest.get("crosscheck"))

    check("invariant: every artifact exists with its columns", True,
          "%d artifacts" % len(ARTIFACT_COLUMNS))

    n_defs = sum(1 for r in funcs if r["kind"] == "def")
    n_use = sum(len(v) for v in uses.values())
    check("invariant: MANIFEST counts match the artifacts",
          (reg.manifest.get("function_defs") == str(n_defs)
           and reg.manifest.get("usage_rows") == str(n_use)),
          "defs %s/%d, usage %s/%d"
          % (reg.manifest.get("function_defs"), n_defs,
             reg.manifest.get("usage_rows"), n_use))

    bad = sorted({r["symbol"] for v in uses.values() for r in v
                  if r["symbol"] not in known})
    check("invariant: every reference names a registered symbol",
          not bad, first(bad))

    # A macro's name in its own body is a use only of a function or object
    # of that name (see index_usage), so a constant's line is a site only
    # when no function or object shares its name.
    objs = list(reg.rows("objects.tsv"))
    code_names = {r["symbol"] for r in funcs} | {r["name"] for r in objs}
    sites = ({(r["symbol"], r["file"], r["line"]) for r in funcs}
             | {(r["name"], r["file"], r["line"]) for r in objs}
             | {(r["name"], r["file"], r["line"]) for r in consts
                if r["name"] not in code_names})
    bad = ["%s %s:%s" % (r["symbol"], r["file"], r["line"])
           for v in uses.values() for r in v
           if (r["symbol"], r["file"], r["line"]) in sites]
    check("invariant: no definition or declaration counts as its own use",
          not bad, first(bad))

    bad = sorted({r["file"] for v in uses.values() for r in v
                  if r["file"] not in cov})
    check("invariant: every reference is in an indexed file",
          not bad, first(bad))

    bad = ["%s %s!=%s" % (r["file"], r["context"], cov[r["file"]]["context"])
           for v in uses.values() for r in v
           if r["file"] in cov and r["context"] != cov[r["file"]]["context"]]
    check("invariant: each reference carries its file's context",
          not bad, first(bad))

    owners = ({(r["file"], r["symbol"]) for r in funcs if r["kind"] == "def"}
              | {(r["file"], r["name"]) for r in consts
                 if r["kind"] in ("define", "define-fn")})
    bad = ["%s:%s in %s" % (r["file"], r["line"], r["enclosing"])
           for v in uses.values() for r in v
           if r["enclosing"] != "-"
           and (r["file"], r["enclosing"]) not in owners]
    check("invariant: each enclosing name is a function or macro of that file",
          not bad, first(bad))

    bad = ["%s %s" % (f, r["final_depth"]) for f, r in sorted(cov.items())
           if r["final_depth"] != "0"]
    bad += ["%s %s:%s" % (r["symbol"], r["file"], r["line"]) for r in funcs
            if r["kind"] == "def" and int(r["end_line"]) < int(r["line"])]
    check("invariant: every file balances and every body closes",
          not bad, first(bad))

    # ---- tree checks

    tree_check("nxt_utf8_next has zero references", "nxt_utf8_next", (),
               lambda: (not uses.get("nxt_utf8_next"),
                        str(files_of("nxt_utf8_next"))))

    tree_check("nxt_utf8_decode2 confined to src/nxt_utf8.{c,h}",
               "nxt_utf8_decode2", ("src/nxt_utf8.c",),
               lambda: (set(files_of("nxt_utf8_decode2"))
                        <= {"src/nxt_utf8.c", "src/nxt_utf8.h"},
                        str(files_of("nxt_utf8_decode2"))))

    # A mention inside a string literal in the test is not a call.
    tree_check("nxt_utf8_casecmp: no production caller", "nxt_utf8_casecmp",
               ("src/test/nxt_utf8_test.c",),
               lambda: (files_of("nxt_utf8_casecmp", {CTX_PROD}) == [],
                        "all=%s" % files_of("nxt_utf8_casecmp")))

    for sym in ("nxt_utf8_encode", "nxt_utf8_length"):
        def fn(sym=sym):
            prod = sorted({r["file"] for r in uses.get(sym, ())
                           if r["context"] == CTX_PROD
                           and r["file"] != "src/nxt_utf8.c"})
            return prod == ["src/nxt_conf.c"], str(prod)
        tree_check("%s production callers are src/nxt_conf.c only" % sym,
                   sym, ("src/nxt_conf.c",), fn)

    def json_escape():
        _fwd, rev = _call_edges(reg)
        seen, frontier, external = ({"nxt_conf_json_escape"},
                                    ["nxt_conf_json_escape"], [])
        for _ in range(6):
            nxt = []
            for sym in frontier:
                for encl, fl, _ln, _ctx in rev.get(sym, ()):
                    if fl != "src/nxt_conf.c":
                        external.append(fl)
                    elif encl != "-" and encl not in seen:
                        seen.add(encl)
                        nxt.append(encl)
            frontier = nxt
        return bool(external), "%d site(s) in %s" % (len(external),
                                                    sorted(set(external)))
    tree_check("nxt_conf_json_escape reached from outside src/nxt_conf.c",
               "nxt_conf_json_escape", ("src/nxt_conf.c",), json_escape)

    # A reference that exists only inside a macro body.
    def conn_socket():
        rs = [r for r in uses.get("nxt_conn_sys_socket", ())
              if r["context"] == CTX_PROD]
        return (any(r["enclosing"] == "nxt_conn_connect" for r in rs),
                str(["%s:%s in %s" % (r["file"], r["line"], r["enclosing"])
                     for r in rs]))
    tree_check("nxt_conn_sys_socket is live via the nxt_conn_connect macro",
               "nxt_conn_sys_socket", (), conn_socket)

    # A wrapper macro whose expansion is the only caller.
    tree_check("nxt_unit_close_impl is reached through the nxt_unit_close "
               "macro", "nxt_unit_close_impl", (),
               lambda: (any(r["enclosing"] == "nxt_unit_close"
                            for r in uses.get("nxt_unit_close_impl", ())),
                        "%d reference(s)"
                        % len(uses.get("nxt_unit_close_impl", ()))))

    # Code inside #if 0 is not compiled, so it is not a reference.
    tree_check("nxt_fiber_main_create's only call site is #if 0, so it is "
               "dead", "nxt_fiber_main_create", ("src/nxt_event_engine.c",),
               lambda: (not uses.get("nxt_fiber_main_create"),
                        "%d reference(s)"
                        % len(uses.get("nxt_fiber_main_create", ()))))

    # The lowcase tables are static arrays: compiled in, but local symbols,
    # so not on the ABI side (which reads exports only). Read from the
    # objects the scanner registered instead; no build needed.
    blocks = sorted({r["name"] for r in reg.rows("objects.tsv")
                     if r["name"].startswith("nxt_unicode_block_")})
    name = "nxt_unicode_block_* are reached only via nxt_utf8_lowcase"
    if not blocks:
        check(name, None, "skipped: no nxt_unicode_block_* registered at "
                          "this ref")
    else:
        def blocks_fn():
            consumers = {r["enclosing"] for v in uses.values() for r in v
                         if r["symbol"].startswith("nxt_unicode_block_")
                         and r["enclosing"] != "-"}
            return (consumers == {"nxt_utf8_lowcase"},
                    "%d blocks; consumers=%s"
                    % (len(blocks), sorted(consumers)))
        tree_check(name, "nxt_utf8_lowcase", (), blocks_fn)

    width = max(len(n) for n, _o, _d in results)
    print("# %s\n" % reg.ref())
    npass = nfail = nskip = 0
    for name, ok, detail in results:
        if ok is None:
            nskip += 1
            tag = "SKIP"
        elif ok:
            npass += 1
            tag = "PASS"
        else:
            nfail += 1
            tag = "FAIL"
        print("%-4s  %-*s  %s" % (tag, width, name, detail))
    print("\n%d passed, %d failed, %d skipped" % (npass, nfail, nskip))
    return 1 if nfail else 0


