VERSION = "1"

# Artifact schema version. Bump when a column changes meaning, so a stale
# index is rejected rather than silently misread.
SCHEMA = "1"


# --------------------------------------------------------------------------
# Classification
#
# Which bucket a file's references count towards. This is the single most
# valuable field in the registry: it is what makes "dead in production"
# answerable, and it is why "nxt_utf8_casecmp has 3 references" is a useless
# answer while "0 production, 2 test, 1 fuzzing" is an actionable one.
#
# The module source list is read from auto/modules/* rather than guessed from
# path prefixes, because two module sources do not live in a module directory:
# src/nxt_php_sapi.c and src/nxt_java.c. Only the code of those scripts is
# read, not their shell comments, and a file that auto/sources lists is core
# code whatever a module script names.
# --------------------------------------------------------------------------

CTX_PROD = "prod"
CTX_TEST = "test"
CTX_FUZZ = "fuzz"
CTX_MODULE = "module"
CTX_TOOL = "tool"

CONTEXT_ORDER = [CTX_PROD, CTX_TEST, CTX_FUZZ, CTX_MODULE, CTX_TOOL]

C_EXT = (".c", ".h")

# Files that are not C. src/nodejs/unit-http/ is a node-gyp C++ addon. It is
# not in auto/modules and Unit's configure never compiles it, so a C scanner
# and a C grammar will disagree about it for reasons that say nothing about
# either. Detected from content rather than by path, so a new one is caught.
# Read on the masked text: the words in a comment, and the standard
# `#ifdef __cplusplus / extern "C" {` guard of a C header, are not C++ code.
# The excluded paths are listed in MANIFEST, and a .c file among them fails
# the index: it is C by name, and dropping it would drop its references.
CXX_MARKERS = re.compile(
    r'^\s*(class\s+\w|namespace\s+\w|template\s*<)', re.M)


def is_cxx(code: str) -> bool:
    return bool(CXX_MARKERS.search(code))

# Directories that are never source of interest.
SKIP_DIRS = {".git", "build", "node_modules", "__pycache__"}

# Roots we walk at all. `go/` holds the Go module: a cgo shim in C
# (go/nxt_cgo_lib.c, which calls nxt_unit_run_ctx) and Go files that call the
# public libunit API directly as `C.name`: nxt_unit_run_shared from
# go/port.go, nxt_unit_dequeue_request from go/request.go, nxt_cgo_run from
# go/unit.go. Those Go call sites are not C, so the scanner never sees them;
# index_go() reads them as module-context references instead (GO_C_REF).
# Without that, `uses nxt_unit_dequeue_request` said "NO REFERENCES ANYWHERE".
# njs/ and pkg/contrib/ are separate upstream checkouts vendored into the
# tree, not FreeUnit source, and are deliberately not indexed.
SCAN_ROOTS = ["src", "test", "fuzzing", "tools", "auto", "go"]


SH_COMMENT = re.compile(r"(?:^|(?<=\s))#.*$", re.M)
SRC_C_RE = re.compile(r"\bsrc/[A-Za-z0-9_/]+\.c\b")


def unreadable_msg(root: str, e: OSError,
                   what="what it holds is missing from the index") -> str:
    """The gate failure for a path that exists and cannot be read."""
    path = os.path.relpath(e.filename, root) if e.filename else "?"
    return "read: cannot read %s (%s): %s" % (path, e.strerror or e, what)


def read_build_file(root: str, rel: str, errors: list):
    """The text of a build-system file, or None when it is absent.

    One that exists and cannot be read is a gate failure, not an empty
    file: the module list and the public headers come from these.
    """
    path = os.path.join(root, rel)
    if not os.path.isfile(path):
        return None
    try:
        with open(path, "r", errors="replace") as fh:
            return fh.read()
    except OSError as e:
        errors.append(unreadable_msg(root, e))
        return None


def _sh_sources(root: str, rel: str, errors: list) -> list:
    """The src/*.c paths a shell build script names, outside its comments.

    A comment can name a core file: auto/modules/php names
    src/nxt_application.c in one, and reading it made that core file
    module code.
    """
    text = read_build_file(root, rel, errors)
    return SRC_C_RE.findall(SH_COMMENT.sub("", text)) if text else []


def read_module_sources(root: str, errors: list) -> dict:
    """Map module source path -> module name, from the build system itself.

    A file that auto/sources lists is core code, whatever a module names.
    """
    mods = {}
    mdir = os.path.join(root, "auto", "modules")
    if not os.path.isdir(mdir):
        return mods
    core = set(_sh_sources(root, "auto/sources", errors))
    try:
        names = sorted(os.listdir(mdir))
    except OSError:
        return mods     # auto/ is a scan root: walk_sources() reports it
    for name in names:
        for src in _sh_sources(root, "auto/modules/" + name, errors):
            if src not in core:
                mods.setdefault(src, name)
    return mods


def read_public_headers(root: str, errors: list) -> set:
    """The headers `make libunit-install` actually installs.

    libunit is a shipped static library with a pkg-config file; language
    modules and third-party applications compile against these headers. A
    function declared in one has consumers this tree cannot see, so "no
    references in the tree" is emphatically NOT "safe to delete" for it:
    nxt_unit_run_shared and nxt_unit_dequeue_request have no in-tree caller and
    are both public API. Read from the install recipe rather than a name
    pattern, so the set follows the build.
    """
    text = read_build_file(root, "auto/make", errors)
    if text is None:
        return set()
    m = re.search(r"^libunit-install:.*?(?=^\S)", text, re.M | re.S)
    if not m:
        return set()
    return set(re.findall(r"\bsrc/[A-Za-z0-9_/]+\.h\b", m.group(0)))


class Classifier:
    def __init__(self, root: str, errors: list):
        self.module_srcs = read_module_sources(root, errors)
        # Module directories, derived from the module source list.
        self.module_dirs = set()
        for p in self.module_srcs:
            d = os.path.dirname(p)
            if d != "src":
                self.module_dirs.add(d + "/")

    def context(self, rel: str) -> str:
        if rel.startswith("src/test/") or rel.startswith("test/"):
            return CTX_TEST
        if rel.startswith("fuzzing/"):
            return CTX_FUZZ
        if rel.startswith("go/"):
            return CTX_MODULE
        if rel in self.module_srcs:
            return CTX_MODULE
        for d in self.module_dirs:
            if rel.startswith(d):
                return CTX_MODULE
        # A header beside a module source belongs to that module.
        if rel.startswith("src/"):
            return CTX_PROD
        return CTX_TOOL


# --------------------------------------------------------------------------
# Stage 1: the lexer
#
# Blank out everything that is not code, preserving byte offsets and line
# structure so every later stage can map an offset back to a line. Directives
# are captured with their *original* text, because masking would eat the path
# in #include "nxt_main.h" and the value in #define NXT_X "y".
# --------------------------------------------------------------------------

class Masked:
    __slots__ = ("code", "brace_code", "usage_code", "src", "line_start",
                 "directives", "nlines", "comment_lines", "path",
                 "cond_conflicts", "define_spans", "cond_marks", "pp_lines")

    def __init__(self, path, src, code, line_start, directives, comment_lines,
                 brace_code, cond_conflicts, usage_code, define_spans,
                 cond_marks=(), pp_lines=frozenset()):
        self.path = path
        self.src = src
        self.code = code                    # for identifiers and usage
        self.brace_code = brace_code        # for brace depth only, see below
        self.line_start = line_start        # offset -> line, via bisect
        self.directives = directives        # (line, raw_text)
        self.comment_lines = comment_lines  # set of lines with any comment
        self.cond_conflicts = cond_conflicts
        self.usage_code = usage_code      # macro bodies kept, see mask()
        self.define_spans = define_spans  # (macro name, first line, last line)
        self.cond_marks = cond_marks      # (start, end, kind, text) per #if..
        self.pp_lines = pp_lines          # lines of #if/#elif/#ifdef/#ifndef
        self.nlines = len(line_start)

    def line_of(self, off: int) -> int:
        # line_start[i] is the offset of line i+1
        lo, hi = 0, len(self.line_start) - 1
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if self.line_start[mid] <= off:
                lo = mid
            else:
                hi = mid - 1
        return lo + 1


DEFINE_NAME_RE = re.compile(r"#\s*define\s+([A-Za-z_][A-Za-z0-9_]*)")
COND_RE = re.compile(r"#\s*(ifdef|ifndef|elif|else|endif|if)\b")
GUARD_RE = re.compile(r"#\s*(?:ifndef\s+|if\s*!\s*defined\s*\(?\s*)"
                      r"([A-Za-z_]\w*)\s*\)?\s*$")


def include_guard(cond_marks):
    """(start, end) of the #ifndef X of an include guard, else None.

    A guard is the first conditional of the file, `#ifndef X` or
    `#if !defined(X)`, whose next directive is `#define X`. Its test is not
    a use of X: counting it would make every guard look used.
    """
    for i, (start, end, kind, dtext) in enumerate(cond_marks):
        if kind is None:
            continue
        m = GUARD_RE.match(dtext)
        if not m or i + 1 >= len(cond_marks):
            return None
        dm = DEFINE_NAME_RE.match(cond_marks[i + 1][3])
        if dm and dm.group(1) == m.group(1):
            return start, end
        return None
    return None

_PP_TOKEN = re.compile(r"\s*(?:(\d+)([uUlL]*)|(defined)\s*(?:\(\s*\w+\s*\)|\w+)"
                       r"|(&&|\|\||==|!=|<=|>=|[!()<>+*-]))")

# Binary operators by C precedence, loosest first. Each level is read left
# to right, so `3 > 2 > 1` is `(3 > 2) > 1`, which is 0, as in C.
_PP_LEVELS = (("||",), ("&&",), ("==", "!="), ("<", ">", "<=", ">="),
              ("+", "-"), ("*",))
_PP_OPS = {
    "||": lambda a, b: int(bool(a) or bool(b)),
    "&&": lambda a, b: int(bool(a) and bool(b)),
    "==": lambda a, b: int(a == b), "!=": lambda a, b: int(a != b),
    "<": lambda a, b: int(a < b), ">": lambda a, b: int(a > b),
    "<=": lambda a, b: int(a <= b), ">=": lambda a, b: int(a >= b),
    "+": lambda a, b: a + b, "-": lambda a, b: a - b,
    "*": lambda a, b: a * b,
}
# Deeper nesting of parentheses and unary operators reads as unknown (a live
# branch) instead of exhausting the Python stack.
PP_MAX_DEPTH = 64


def _pp_eval(toks, bits):
    """The value of the token list, with defined() number k set to bit k."""
    pos = 0

    def binary(level, depth):
        nonlocal pos
        if level == len(_PP_LEVELS):
            return unary(depth)
        v = binary(level + 1, depth)
        while pos < len(toks) and toks[pos] in _PP_LEVELS[level]:
            op = toks[pos]
            pos += 1
            v = _PP_OPS[op](v, binary(level + 1, depth))
        return v

    def unary(depth):
        nonlocal pos
        if depth > PP_MAX_DEPTH or pos >= len(toks):
            raise ValueError
        t = toks[pos]
        pos += 1
        if isinstance(t, int):
            return t
        if isinstance(t, tuple):
            return (bits >> t[1]) & 1
        if t == "!":
            return int(not unary(depth + 1))
        if t == "-":
            return -unary(depth + 1)
        if t == "+":
            return unary(depth + 1)
        if t == "(":
            v = binary(0, depth + 1)
            if pos >= len(toks) or toks[pos] != ")":
                raise ValueError
            pos += 1
            return v
        raise ValueError

    v = binary(0, 0)
    if pos != len(toks):
        raise ValueError
    return v


def pp_const(expr: str):
    """True or False for an #if/#elif expression that is constant, else None.

    `#if 0` is not the only spelling of a dead branch: `#if !1` and
    `#if 0 && defined(X)` are false whatever is defined. `defined(X)` is
    unknown, so it is tried both ways, and the expression is constant only if
    every way agrees. Any other identifier makes it unknown (a live branch).
    """
    toks, i, n_defined = [], 0, 0
    while i < len(expr):
        if expr[i:].strip() == "":
            break
        m = _PP_TOKEN.match(expr, i)
        if not m:
            return None
        if m.group(1) is not None:
            # Unsigned arithmetic is not modelled (`0u - 1 > 0` is true in
            # C), so an unsigned literal makes the expression unknown.
            if "u" in m.group(2).lower():
                return None
            d = m.group(1)
            try:
                toks.append(int(d, 8) if d.startswith("0") else int(d))
            except ValueError:      # 08, 09
                return None
        elif m.group(3):
            toks.append(("D", n_defined))
            n_defined += 1
        else:
            toks.append(m.group(4))
        i = m.end()
    if not toks or n_defined > 4:
        return None
    seen = set()
    for bits in range(1 << n_defined):
        try:
            seen.add(bool(_pp_eval(toks, bits)))
        except ValueError:
            return None
    return seen.pop() if len(seen) == 1 else None


def _cond_expr(dtext: str) -> str:
    m = re.match(r"#\s*(?:el)?if\b(.*)", dtext, re.S)
    return m.group(1) if m else ""


def mask(path: str, src: str) -> Masked:
    """Blank what is not code, keeping byte offsets and lines intact.

    Two views are produced over the same offsets:

      code        comments, literals and whole preprocessor directives blanked.
                  The top-level parser and the brace scanner read this.
      usage_code  the same, except the *body* of every #define is kept. Macro
                  bodies are real code and blanking them wholesale is how
                  nxt_conn_sys_socket (src/nxt_conn_connect.c:14) came to be
                  reported as having no caller anywhere: its only reference is
                  inside the #define nxt_conn_connect body at src/nxt_conn.h:296,
                  which is live from src/nxt_h1proto.c:2411 and three sites in
                  src/nxt_conn_proxy.c. Nine functions were wrong this way,
                  including nxt_unit_close_impl, which src/nxt_unit.c:206 wraps
                  and that file then calls 24 times.

    A `#if 0` branch is blanked in both views: it is not compiled, so neither
    its definitions nor its references are real.
    """
    n = len(src)
    buf = list(src)     # -> code
    ubuf = list(src)    # -> usage_code
    directives = []
    cond_marks = []
    define_spans = []
    pp_lines = set()
    comment_lines = set()

    line_start = [0]
    for i, ch in enumerate(src):
        if ch == "\n":
            line_start.append(i + 1)

    def line_of(off):
        lo, hi = 0, len(line_start) - 1
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if line_start[mid] <= off:
                lo = mid
            else:
                hi = mid - 1
        return lo + 1

    def blank(lo, hi, both=True):
        for k in range(lo, min(hi, n)):
            if src[k] != "\n":
                buf[k] = " "
                if both:
                    ubuf[k] = " "

    def restore(lo, hi, noncode):
        # Put src[lo:hi] back into usage_code; literals and comments in it
        # stay blank.
        for k in range(lo, min(hi, n)):
            if src[k] != "\n":
                ubuf[k] = src[k]
        for a, b in noncode:
            for k in range(max(a, lo), min(b, n)):
                if src[k] != "\n":
                    ubuf[k] = " "

    i = 0
    at_line_start = True
    while i < n:
        ch = src[i]

        if ch == "\n":
            at_line_start = True
            i += 1
            continue

        if ch in " \t\r":
            i += 1
            continue

        # ---- block comment
        if ch == "/" and i + 1 < n and src[i + 1] == "*":
            j = src.find("*/", i + 2)
            j = n if j < 0 else j + 2
            blank(i, j)
            for ln in range(line_of(i), line_of(min(j, n - 1) if n else 0) + 1):
                comment_lines.add(ln)
            i = j
            continue

        # ---- line comment
        if ch == "/" and i + 1 < n and src[i + 1] == "/":
            j = src.find("\n", i)
            j = n if j < 0 else j
            blank(i, j)
            comment_lines.add(line_of(i))
            i = j
            continue

        # ---- preprocessor directive (only at logical line start)
        if ch == "#" and at_line_start:
            start = i
            j = i
            raw = []
            # Comments and literals inside the directive: blanked from the
            # macro body that usage_code restores below.
            noncode = []
            while j < n:
                # A literal is copied whole: `/*` or `//` inside one, as in
                # `#define NXT_GLOB "src/*.c"`, does not open a comment.
                # Taking it for one cut the value short and, for `/*`, left
                # a phantom block comment that blanked the rest of the file.
                if src[j] in "\"'":
                    quote = src[j]
                    lit = j
                    raw.append(src[j])
                    j += 1
                    while j < n and src[j] != "\n":
                        if src[j] == "\\" and j + 1 < n:
                            raw.append(" " if src[j + 1] == "\n"
                                       else src[j:j + 2])
                            j += 2
                            continue
                        raw.append(src[j])
                        j += 1
                        if src[j - 1] == quote:
                            break
                    noncode.append((lit, j))
                    continue
                # A comment inside a directive is one space, and the
                # directive goes on after it: `#if /* off */ 0` is `#if 0`,
                # and a commented continuation line of a macro does not end
                # the macro (the rest of it is not top-level code).
                if src[j] == "/" and j + 1 < n and src[j + 1] == "*":
                    e = src.find("*/", j + 2)
                    e = n if e < 0 else e + 2
                    for ln in range(line_of(j), line_of(max(j, e - 1)) + 1):
                        comment_lines.add(ln)
                    noncode.append((j, e))
                    raw.append(" ")
                    j = e
                    continue
                if src[j] == "/" and j + 1 < n and src[j + 1] == "/":
                    e = j
                    while e < n and src[e] != "\n":
                        e += 1
                    comment_lines.add(line_of(j))
                    noncode.append((j, e))
                    j = e
                    break
                if src[j] == "\n":
                    k = j - 1
                    while k >= start and src[k] in " \t\r":
                        k -= 1
                    if k >= start and src[k] == "\\":
                        # The backslash and the newline are one space.
                        while raw and raw[-1] in " \t\r":
                            raw.pop()
                        if raw and raw[-1] == "\\":
                            raw[-1] = " "
                        else:
                            raw.append(" ")
                        j += 1
                        continue
                    break
                raw.append(src[j])
                j += 1

            dtext = "".join(raw).strip()
            blank(start, j)

            dm = DEFINE_NAME_RE.match(src, start)
            if dm:
                # Keep the macro body in usage_code. The body begins after the
                # name, or after the parameter list for a function-like macro
                # (which requires '(' immediately after the name).
                body = dm.end()
                if body < n and src[body] == "(":
                    d, k = 0, body
                    while k < j:
                        if src[k] == "(":
                            d += 1
                        elif src[k] == ")":
                            d -= 1
                            if d == 0:
                                k += 1
                                break
                        k += 1
                    body = k
                restore(body, j, noncode)
                define_spans.append((dm.group(1), line_of(start),
                                     line_of(max(start, j - 1))))

            cm = COND_RE.match(dtext)
            pm = COND_RE.match(src, start)
            if pm and pm.group(1) not in ("else", "endif"):
                # Keep the condition in usage_code too, so that a macro
                # tested only in #if (NXT_MP_CLUSTER_CACHE) is not reported
                # as unused. index_usage() gives these the kind `pp`.
                restore(pm.end(), j, noncode)
                pp_lines.update(range(line_of(start),
                                      line_of(max(start, j - 1)) + 1))
            directives.append((line_of(start), dtext))
            cond_marks.append((start, j, cm.group(1) if cm else None, dtext))
            i = j
            at_line_start = False
            continue

        at_line_start = False

        # ---- string / char literal
        if ch in "\"'":
            quote = ch
            j = i + 1
            while j < n:
                if src[j] == "\\":
                    j += 2
                    continue
                if src[j] == quote:
                    j += 1
                    break
                if src[j] == "\n" and quote == "'":
                    break
                j += 1
            blank(i, min(j, n))
            i = min(j, n)
            continue

        i += 1

    guard = include_guard(cond_marks)
    if guard:
        blank(*guard)   # usage_code too, so its lines hold no name

    # ---- #if 0 branches are not compiled; neither their defs nor their refs
    # are real. src/nxt_event_engine.c:65 was the example: it kept
    # nxt_fiber_main_create off the dead list on the strength of a call that
    # is not built (src/nxt_cert.c:1316 is one on master at d54b109a). Any
    # constant expression counts, not only the `#if 0` spelling: `#if !1`,
    # `#if 0 && defined(X)`, and the #else of `#if 1`; see pp_const().
    # Each open group is [start of a dead branch or None, a branch was
    # constant-true]. Once one branch is constant-true every later one is dead.
    stack = []
    dead_ranges = []
    for start, end, kind, dtext in cond_marks:
        if kind in ("if", "ifdef", "ifndef"):
            v = pp_const(_cond_expr(dtext)) if kind == "if" else None
            stack.append([end if v is False else None, v is True])
        elif kind in ("elif", "else") and stack:
            grp = stack[-1]
            if grp[0] is not None:
                blank(grp[0], start)
                dead_ranges.append((grp[0], start))
            v = (pp_const(_cond_expr(dtext)) if kind == "elif" else None)
            grp[0] = end if (grp[1] or v is False) else None
            grp[1] = grp[1] or v is True
        elif kind == "endif":
            if stack:
                dead = stack.pop()[0]
                if dead is not None:
                    blank(dead, start)
                    dead_ranges.append((dead, start))
    # Nor are its #define and #include: they were captured before this pass.
    if dead_ranges:
        directives = [d for d, (st, _e, _k, _t) in zip(directives, cond_marks)
                      if not any(lo <= st < hi for lo, hi in dead_ranges)]

    code = "".join(buf)
    brace_code, conflicts = _balance_conditionals(code, cond_marks)
    return Masked(path, src, code, line_start, directives, comment_lines,
                  brace_code, conflicts, "".join(ubuf), define_spans,
                  cond_marks, pp_lines)


def _balance_conditionals(code: str, cond_marks, keep=None):
    """Neutralise braces in #if/#else branches that do not balance each other.

    Only one branch of a conditional is ever compiled, but the blanked text
    holds all of them, so every brace in an alternative branch is counted a
    second time and the scan desynchronises for the rest of the file.
    src/nxt_openssl.c:464-470 is the example (on master at d54b109a; it was
    426-430 when this was written):

        #ifdef SSL_CTX_add0_chain_cert
                if (SSL_CTX_add0_chain_cert(ctx, ca) != 1) {
        #else
                if (SSL_CTX_add_extra_chain_cert(ctx, ca) != 1) {
        #endif

    Two `{`, one real. Left alone, every function after that line is swallowed
    into the body of the one before it: 23 of the file's 27 definitions
    disappeared, and the coverage gate was satisfied because a runaway body
    "accounts for" every line it eats.

    So for depth purposes we keep the first branch and neutralise the braces in
    the alternatives. Where the branches carry different brace deltas that
    choice is not neutral: the file's cond_conflicts in coverage.tsv counts
    it, and alternative_defs() scans the file again once per other branch, so
    a definition that only another branch opens is still indexed. `keep` maps
    a group (the offset of its first branch) to the branch to keep instead.
    The usage index always reads the unmodified text, so no reference is lost
    either way.

    Returns the balanced text and one (first branch offset, branches) entry
    per group that straddles a brace.
    """
    buf = list(code)
    conflicts = []
    stack = []
    for start, end, kind, _dtext in cond_marks:
        if kind in ("if", "ifdef", "ifndef"):
            stack.append({"branches": [[end, None]], "start": start})
            continue
        if not stack:
            continue
        if kind in ("elif", "else"):
            stack[-1]["branches"][-1][1] = start
            stack[-1]["branches"].append([end, None])
            continue
        if kind == "endif":
            grp = stack.pop()
            grp["branches"][-1][1] = start
            if len(grp["branches"]) < 2:
                continue
            # Inner groups have already been corrected, so measure on `buf`.
            deltas = []
            for b0, b1 in grp["branches"]:
                seg = "".join(buf[b0:b1])
                deltas.append(seg.count("{") - seg.count("}"))
            # A group whose every branch is internally balanced cannot
            # desynchronise anything, so keep them all. That is what lets a
            # whole function definition sit inside #else and still be indexed
            # (src/nxt_clang.h nxt_popcount). Only a group that straddles a
            # brace needs one branch chosen, and then the choice is a real
            # judgement, so record it.
            if not any(deltas):
                continue
            key = grp["branches"][0][0]
            conflicts.append((key, [tuple(b) for b in grp["branches"]]))
            pick = (keep or {}).get(key, 0)
            for bi, (b0, b1) in enumerate(grp["branches"]):
                if bi == pick:
                    continue
                for k in range(b0, b1):
                    if buf[k] in "{}":
                        buf[k] = " "
    return "".join(buf), conflicts


# --------------------------------------------------------------------------
# Stage 2: the top-level scanner
#
# Walk the blanked text tracking brace depth. At depth 0 accumulate a
# statement; a `{` that follows a balanced `(...)` opens a function body,
# anything else is an aggregate (struct/enum/union/initialiser) and keeps
# accumulating until its `;`.
# --------------------------------------------------------------------------

# The lookbehind keeps the suffix of a number (`L` in `201112L`, `UL` in
# `16UL`) from reading as an identifier.
IDENT = re.compile(r"(?<![0-9A-Za-z_])[A-Za-z_][A-Za-z0-9_]*")

# Noise that can sit between the parameter list and the body, or masquerade as
# the declarator when scanning right-to-left.
DECL_NOISE = {"__attribute__", "__asm__", "asm", "NXT_MAYBE_UNUSED"}

# A keyword is never a declarator. Without this `typedef void (*fn_t)(void)`
# registered `void` as a declared function, and every `void` in the tree then
# counted as a reference to it.
C_KEYWORDS = {
    "auto", "break", "case", "char", "const", "continue", "default", "do",
    "double", "else", "enum", "extern", "float", "for", "goto", "if",
    "inline", "int", "long", "register", "restrict", "return", "short",
    "signed", "sizeof", "static", "struct", "switch", "typedef", "union",
    "unsigned", "void", "volatile", "while", "_Bool", "_Noreturn",
    "_Static_assert", "_Alignof", "_Alignas", "_Atomic", "_Thread_local"}

FNPTR_NAME = re.compile(r"\(\s*\*+\s*(?:(?:const|volatile|restrict)\s+)*"
                        r"([A-Za-z_]\w*)")

STORAGE_KEYS = ("NXT_EXPORT", "nxt_inline", "static", "extern", "inline")


class FuncDef:
    __slots__ = ("name", "line", "end_line", "storage", "signature",
                 "col1", "macro", "body_start", "body_end", "param_sites",
                 "header_sites",
                 "open_off", "close_off")

    def __init__(self, name, line, end_line, storage, signature, col1, macro,
                 body_start, body_end):
        self.name = name
        self.line = line
        self.end_line = end_line
        self.storage = storage
        self.signature = signature
        self.col1 = col1
        self.macro = macro
        self.body_start = body_start
        self.body_end = body_end
        self.param_sites = []
        self.header_sites = []      # (line, name) of the other #if arms' headers
        self.open_off = None        # offsets of the body's braces
        self.close_off = None


class FuncDecl:
    __slots__ = ("name", "line", "storage", "signature", "param_sites")

    def __init__(self, name, line, storage, signature):
        self.name = name
        self.line = line
        self.storage = storage
        self.signature = signature
        self.param_sites = []


def _split_declarator(stmt: str):
    """Return (prefix, name, params) for the outermost `name(...)`.

    Scans right to left so that a function-pointer parameter or a trailing
    __attribute__ does not win over the real declarator.
    """
    j = len(stmt)
    while True:
        close = stmt.rfind(")", 0, j)
        if close < 0:
            return None
        depth = 0
        k = close
        while k >= 0:
            if stmt[k] == ")":
                depth += 1
            elif stmt[k] == "(":
                depth -= 1
                if depth == 0:
                    break
            k -= 1
        if k < 0:
            return None
        # `(*name)` or `(*name(params))`: the declarator is inside the group,
        # and the identifier before it is the return type. A function that
        # returns a function pointer is declared inside; a bare `(*name)` is
        # a function-pointer object or typedef, not a function.
        inner = stmt[k + 1:close]
        if inner.lstrip().startswith("*"):
            parts = _split_declarator(inner)
            if parts is None:
                return None
            return stmt[:k + 1] + parts[0], parts[1], parts[2]
        # identifier immediately before the '('
        m = None
        e = k
        while e > 0 and stmt[e - 1] in " \t\n":
            e -= 1
        s = e
        while s > 0 and (stmt[s - 1].isalnum() or stmt[s - 1] == "_"):
            s -= 1
        if s < e:
            m = stmt[s:e]
        if (m and m not in DECL_NOISE and m not in C_KEYWORDS
                and not m.isdigit()):
            return stmt[:s], m, stmt[k + 1:close]
        j = k          # skip past this group and keep scanning left
        if j <= 0:
            return None


def _strip_trailing_groups(t: str) -> str:
    """Remove trailing `[...]` array bounds and `IDENT(...)` attribute macros.

    `static const uint32_t nxt_unicode_block_000[128] nxt_aligned(64)` ends in
    an alignment macro, so a naive "last identifier wins" reads the declarator
    name as `nxt_aligned`, for all 26 blocks in src/nxt_unicode_lowcase.h.
    Every reference to them then fails to resolve and the symbols read as
    unreferenced, which is a plausible-looking answer and the wrong one.
    """
    t = t.rstrip()
    while True:
        before = t
        if t.endswith("]"):
            d, k = 0, len(t) - 1
            while k >= 0:
                if t[k] == "]":
                    d += 1
                elif t[k] == "[":
                    d -= 1
                    if d == 0:
                        break
                k -= 1
            if k >= 0:
                t = t[:k].rstrip()
        elif t.endswith(")"):
            d, k = 0, len(t) - 1
            while k >= 0:
                if t[k] == ")":
                    d += 1
                elif t[k] == "(":
                    d -= 1
                    if d == 0:
                        break
                k -= 1
            if k >= 0:
                head = t[:k].rstrip()
                m = re.search(r"[A-Za-z_]\w*$", head)
                # Only an identifier-led group is an attribute macro; a bare
                # `(...)` belongs to a function pointer declarator.
                if m:
                    t = head[:m.start()].rstrip()
                else:
                    break
            else:
                break
        if t == before:
            break
    return t


def _depth0(t: str) -> str:
    """The characters of t outside any parentheses or brackets."""
    out, depth = [], 0
    for ch in t:
        if ch in "([":
            depth += 1
        elif ch in ")]":
            depth -= 1
        elif depth == 0:
            out.append(ch)
    return "".join(out)


def _split_top_commas(t: str):
    out, depth, cur = [], 0, []
    for ch in t:
        if ch in "([":
            depth += 1
        elif ch in ")]":
            depth -= 1
        if ch == "," and depth == 0:
            out.append("".join(cur))
            cur = []
            continue
        cur.append(ch)
    out.append("".join(cur))
    return out


def _flatten_braces(t: str) -> str:
    """t with the contents of every outermost `{...}` removed.

    The members of `typedef struct { uint32_t a, b, c; } nxt_sha1_t` are not
    top-level objects; only the declarators after the closing brace are.
    """
    out, depth = [], 0
    for ch in t:
        if ch == "{":
            if depth == 0:
                out.append("{")
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                out.append("}")
        elif depth == 0:
            out.append(ch)
    return "".join(out)


# Words that can stand before a parameter's type and are not one.
_PARAM_QUALIFIERS = {"const", "volatile", "restrict", "register", "struct",
                     "union", "enum"}


def param_sites(mk: Masked, name_off: int, name: str):
    """(line, name) of every parameter declarator of the function at name_off.

    `nxt_conf_json_error_t *error` in a prototype names a parameter, not the
    file-static `error` in src/nxt_http_error.c; counting it inflated `uses`.
    The types in the list are real references and stay counted. A segment
    that is only a type (`nxt_task_t`, `const nxt_str_t`) declares nothing.
    """
    code = mk.code
    k = name_off + len(name)
    while k < len(code) and code[k] in " \t\n":
        k += 1
    if k >= len(code) or code[k] != "(":
        return []
    d, e = 0, k
    while e < len(code):
        if code[e] == "(":
            d += 1
        elif code[e] == ")":
            d -= 1
            if d == 0:
                break
        e += 1
    out, seg_start, depth = [], k + 1, 0
    for p in range(k + 1, e + 1):
        ch = code[p]
        if ch in "([":
            depth += 1
        elif ch in ")]" and p != e:
            depth -= 1
        if p == e or (ch == "," and depth == 0):
            seg = code[seg_start:p]
            t = _strip_trailing_groups(seg)
            m = re.search(r"[A-Za-z_]\w*$", t)
            # An upper-case name is a macro (`int type TSRMLS_DC`), a use.
            if (m and m.group(0) not in C_KEYWORDS
                    and not re.fullmatch(r"[A-Z][A-Z0-9_]*", m.group(0))):
                rest = set(IDENT.findall(t[:m.start()]))
                if (rest - _PARAM_QUALIFIERS) or "*" in t[:m.start()]:
                    out.append((mk.line_of(seg_start + m.start()),
                                m.group(0)))
            elif not m:
                m = FNPTR_NAME.search(t)
                if m:
                    out.append((mk.line_of(seg_start + m.start(1)),
                                m.group(1)))
            seg_start = p + 1
    return out


def declarator_names(head: str):
    """Every object name declared by one top-level statement."""
    names = []
    for seg in _split_top_commas(head):
        t = _strip_trailing_groups(seg)
        m = re.search(r"[A-Za-z_]\w*$", t)
        if not m:
            # `typedef void (*nxt_cb_t)(void)`: the name is inside the group.
            m = FNPTR_NAME.search(t)
            if m:
                names.append(m.group(1))
        elif m.group(0) not in C_KEYWORDS:
            names.append(m.group(0))
    return names


def _storage_of(prefix: str) -> str:
    toks = set(IDENT.findall(prefix))
    for key in STORAGE_KEYS:
        if key in toks:
            return key
    return "extern"


class TopVar:
    __slots__ = ("name", "line", "kind", "storage", "text")

    def __init__(self, name, line, kind, storage, text):
        self.name = name
        self.line = line
        self.kind = kind
        self.storage = storage
        self.text = text


def scan_top_level(mk: Masked):
    """Walk the top level of the translation unit.

    Brace depth is tracked on mk.brace_code (conditional branches balanced);
    every identifier and declarator is read from the same offsets in mk.code,
    which is unmodified. Returns definitions, declarations, objects, aggregate
    bodies, the line spans consumed, and the final brace depth, which must be
    zero for a well-formed file and is gated on: a body that runs to EOF
    without closing is the runaway that ate 23 of nxt_openssl.c's 27
    definitions while leaving the line accounting looking perfect.
    """
    code = mk.code
    depth_src = mk.brace_code
    n = len(code)
    defs, decls, objs, aggregates, spans = [], [], [], [], []
    runaway = 0
    stray = 0
    linkage = 0     # open `extern "C" {` blocks

    i = 0
    depth = 0
    stmt_start = 0
    while i < n:
        ch = depth_src[i]
        if ch == "{":
            if depth == 0:
                stmt = code[stmt_start:i]
                tail = stmt.rstrip()
                # `extern "C" {` is a linkage specification, not a scope: its
                # contents are still at the top level. The string literal is
                # already blanked, so the statement reads as a bare `extern`.
                if tail.split() == ["extern"]:
                    linkage += 1
                    spans.append((mk.line_of(stmt_start + len(stmt)
                                             - len(stmt.lstrip())),
                                  mk.line_of(i)))
                    i += 1
                    stmt_start = i
                    continue
                parts = _split_declarator(tail)
                is_fn = parts is not None and tail.endswith(")")
                body_open = i
                d = 1
                j = i + 1
                while j < n and d:
                    if depth_src[j] == "{":
                        d += 1
                    elif depth_src[j] == "}":
                        d -= 1
                    j += 1
                if d:
                    # Ran to EOF without closing: this construct has swallowed
                    # the rest of the translation unit.
                    runaway += 1
                body_close = j - 1
                if is_fn:
                    prefix, name, params = parts
                    off = stmt_start + len(prefix)
                    name_line = mk.line_of(off)
                    col = off - mk.line_start[name_line - 1] + 1
                    macro = bool(re.fullmatch(r"[A-Z][A-Z0-9_]*", name))
                    sig = " ".join((prefix + name + "(" + params + ")").split())
                    defs.append(FuncDef(
                        name, name_line, mk.line_of(body_close),
                        _storage_of(prefix), sig, col == 1, macro,
                        mk.line_of(body_open), mk.line_of(body_close)))
                    defs[-1].open_off, defs[-1].close_off = body_open, body_close
                    if not macro:
                        sites = param_sites(mk, off, name)
                        # Each #if arm can hold its own header for the one
                        # body (src/nxt_php_sapi.c, nxt_php_read_post). An
                        # earlier header is part of the definition, not a
                        # call of it.
                        head = code[stmt_start:off]
                        for hm in (IDENT.finditer(head) if name in head
                                   else ()):
                            if hm.group(0) != name:
                                continue
                            ho = stmt_start + hm.start()
                            defs[-1].header_sites.append((mk.line_of(ho),
                                                          name))
                            sites.extend(param_sites(mk, ho, name))
                        defs[-1].param_sites = sites
                    # ZEND_NAMED_FUNCTION(nxt_php_chdir) and XS(XS_..._cb)
                    # define a function whose name is the macro *argument*.
                    # Registering only the macro left the whole PHP-extension
                    # and Perl-XS surface answering "no function named that",
                    # which reads identically to "dead".
                    if macro and re.fullmatch(r"[A-Za-z_]\w*", params.strip()):
                        defs.append(FuncDef(
                            params.strip(), name_line, mk.line_of(body_close),
                            _storage_of(prefix), sig, False, "macro-arg",
                            mk.line_of(body_open), mk.line_of(body_close)))
                        defs[-1].open_off = body_open
                        defs[-1].close_off = body_close
                    spans.append((mk.line_of(stmt_start
                                             + (len(stmt) - len(stmt.lstrip()))
                                             if stmt.strip() else stmt_start),
                                  mk.line_of(body_close)))
                    i = j
                    stmt_start = i
                    continue
                # struct/enum/union/initialiser: the ';' closes the statement
                aggregates.append((stmt_start, body_open, body_close,
                                   mk.line_of(stmt_start)))
                i = j
                continue
            depth += 1
            i += 1
            continue

        if ch == "}":
            if depth == 0 and linkage:
                # The end of `extern "C" {`, as in the __cplusplus guard of a
                # C header.
                linkage -= 1
                spans.append((mk.line_of(i), mk.line_of(i)))
                i += 1
                stmt_start = i
                continue
            if depth == 0:
                # Clamping this to zero let a single stray closing brace
                # neutralise the runaway gate: nxt_router.c lost 105 of its 106
                # definitions and still reported final_depth 0, gates OK.
                stray += 1
            else:
                depth -= 1
            i += 1
            continue

        if ch == ";" and depth == 0:
            stmt = code[stmt_start:i]
            lead = len(stmt) - len(stmt.lstrip())
            s_ = stmt.strip()
            if s_:
                line0 = mk.line_of(stmt_start + lead)
                # An aggregate's members are not top-level declarators.
                flat = _flatten_braces(s_)
                parts = _split_declarator(s_) if "{" not in flat else None
                # `static const nxt_str_t p = nxt_string("/api")` is an
                # object with a macro initialiser, not a prototype of the
                # macro: a prototype has no `=` outside its parentheses.
                if parts is not None and s_.endswith(")") \
                        and "=" not in _depth0(s_):
                    prefix, name, params = parts
                    sig = " ".join((prefix + name + "(" + params + ")").split())
                    # The name's own line, not the statement's. In house style
                    # the return type sits on its own line, so recording line0
                    # left the prototype counting as a reference to itself:
                    # src/nxt_rbtree.h:115 was the only "reference" that
                    # nxt_rbtree_find_greater_or_equal had anywhere.
                    off = stmt_start + lead + len(prefix)
                    decls.append(FuncDecl(
                        name, mk.line_of(off), _storage_of(prefix), sig))
                    # A top-level macro call such as nxt_static_assert(...)
                    # has no return type before it, and its arguments are
                    # expressions, not parameters.
                    if prefix.strip():
                        decls[-1].param_sites = param_sites(mk, off, name)
                else:
                    # A top-level object: `PyObject *nxt_py_body_str;`, a
                    # table, or a typedef. Registering these is what keeps
                    # src/python/nxt_python_asgi_str.c (143 lines, 55 of them
                    # bare PyObject declarations) from reading as unaccounted.
                    head = _flatten_braces(s_).split("=")[0]
                    kind = ("typedef" if "typedef" in IDENT.findall(head)
                            else "var")
                    for name in declarator_names(head):
                        objs.append(TopVar(name, line0, kind,
                                           _storage_of(head),
                                           " ".join(s_.split())[:160]))
                spans.append((line0, mk.line_of(i)))
            i += 1
            stmt_start = i
            continue

        i += 1

    return (defs, decls, objs, aggregates, spans,
            depth + runaway + stray + linkage)


def alternative_defs(mk: Masked, defs):
    """Definitions that only another branch of a brace-straddling #if opens.

    The scanner keeps the first branch of such a group, so in

        #ifdef NXT_ALT
        static int nxt_alt_def(void) {
        #else
        static int nxt_norm_def(void) {
        #endif

    nxt_norm_def is not seen, and ast-grep, which reads both, does see it.
    That used to fail the whole index. Instead the file is scanned once more
    per other branch of each such group, with that branch kept and the rest of
    the group blanked, and every definition this finds under a new name is
    added. A variant that does not balance is ignored: its definitions would
    be the runaway kind. Only definitions are taken; the usage index already
    reads every branch.
    """
    have = {d.name for d in defs}
    extra = []
    for key, branches in mk.cond_conflicts:
        for pick in range(1, len(branches)):
            buf = list(mk.code)
            for bi, (b0, b1) in enumerate(branches):
                if bi == pick:
                    continue
                for k in range(b0, b1):
                    if buf[k] != "\n":
                        buf[k] = " "
            code = "".join(buf)
            brace, _ = _balance_conditionals(code, mk.cond_marks, {key: pick})
            alt = Masked(mk.path, mk.src, code, mk.line_start, mk.directives,
                         mk.comment_lines, brace, mk.cond_conflicts,
                         mk.usage_code, mk.define_spans, mk.cond_marks)
            adefs, _d, _o, _a, _s, depth = scan_top_level(alt)
            if depth:
                continue
            for d in adefs:
                if d.name not in have:
                    have.add(d.name)
                    extra.append(d)
    return extra


# --------------------------------------------------------------------------
# Constants: #define and enum members
# --------------------------------------------------------------------------

DEFINE_RE = re.compile(r"#\s*define\s+([A-Za-z_][A-Za-z0-9_]*)(\()?\s*(.*)")
INCLUDE_RE = re.compile(r"#\s*include\s*([<\"])([^>\"]+)[>\"]")


# constants.tsv cuts a longer value, and marks the cut with "...".
MAX_VALUE = 120


def extract_directives(mk: Masked):
    consts, includes = [], []
    for line, raw in mk.directives:
        m = DEFINE_RE.match(raw)
        if m:
            name, fnlike, value = m.group(1), bool(m.group(2)), m.group(3)
            if fnlike:
                # The value column is the body; the parameter list that the
                # regex left in front of it is not part of the value.
                close = value.find(")")
                value = value[close + 1:] if close >= 0 else ""
            value = " ".join(value.split())
            if len(value) > MAX_VALUE:
                value = value[:MAX_VALUE - 3] + "..."
            consts.append((name, "define-fn" if fnlike else "define", line,
                           value))
            continue
        m = INCLUDE_RE.match(raw)
        if m:
            includes.append((m.group(2),
                             "angle" if m.group(1) == "<" else "quote"))
    return consts, includes


ENUM_HEAD = re.compile(r"\benum\b(?:\s+[A-Za-z_]\w*)?\s*\{")


def extract_enums(mk: Masked, aggregates):
    """Enum member names, from every `enum {` in a top-level aggregate.

    That includes an enum nested in a struct, whose members are file-scope
    constants all the same: NXT_ROUTER_ENGINE_ADD in src/nxt_router.h is one.
    """
    out = []
    code = mk.code
    for stmt_start, _body_open, body_close, _line in aggregates:
        for em in ENUM_HEAD.finditer(code, stmt_start, body_close + 1):
            base = em.end()
            depth = 0
            expect = True
            i = base
            while i < body_close:
                c = code[i]
                if c in "([{":
                    depth += 1
                elif c in ")]}":
                    if depth == 0:
                        break
                    depth -= 1
                elif depth == 0 and c == ",":
                    expect = True
                elif depth == 0 and c == "=":
                    expect = False
                elif expect and (c.isalpha() or c == "_"):
                    m = IDENT.match(code, i)
                    if m:
                        out.append((m.group(0), "enum", mk.line_of(i), ""))
                        i = m.end()
                        expect = False
                        continue
                i += 1
    return out


# --------------------------------------------------------------------------
# Usage index
#
# Every identifier occurrence in blanked code that names a registered symbol,
# with the enclosing function and the context bucket. A `call` is an
# occurrence followed by `(`; anything else is a `ref` (a function pointer
# taken, a constant read).
#
# Definition and declaration sites are excluded: they are what defines the
# symbol, not a use of it. That is why `nxt_utf8_next` correctly reports zero
# references despite being defined at src/nxt_utf8.h:32.
# --------------------------------------------------------------------------

# Words that start a statement which is never a declaration.
_STMT_KEYWORDS = {"if", "else", "while", "do", "for", "switch", "return",
                  "goto", "break", "continue", "case", "default", "sizeof"}
# Words that, first in a statement, make it a declaration.
_DECL_START = {"auto", "char", "const", "double", "enum", "extern", "float",
               "int", "long", "register", "restrict", "short", "signed",
               "static", "struct", "union", "unsigned", "void", "volatile",
               "_Bool", "_Atomic", "_Thread_local", "inline", "typedef"}
_LABEL = re.compile(r"\s*(?:case\b[^;:]*|default|[A-Za-z_]\w*)\s*:(?!:)")
_NOT_DECL_HEAD = re.compile(r"->|\.|\+\+|--|[-+*/%&|^!<>]=|<<|>>|[?:]")


def _local_declarators(stmt: str):
    """The names a block-scope statement declares, or [] if it is not one.

    `nxt_int_t  error;`, `const char  *p, *q = NULL;`, `static int n;`:
    a type word or a typedef name followed by a declarator. A statement led
    by a keyword such as `return`, a call, an assignment or a member access
    declares nothing. Ambiguous `a * b;` reads as a declaration, which is
    what it would be anywhere it is not dead code.
    """
    while True:
        m = _LABEL.match(stmt)
        if not m:
            break
        stmt = stmt[m.end():]
    flat = _flatten_braces(stmt)
    words = IDENT.findall(flat)
    if not words:
        return []
    m = re.match(r"\s*([A-Za-z_]\w*)", flat)
    if not m or m.group(1) in _STMT_KEYWORDS:
        return []
    first = m.group(1)
    segs = _split_top_commas(flat)
    head0 = _depth0(segs[0].split("=", 1)[0])
    if _NOT_DECL_HEAD.search(head0) or "==" in _depth0(segs[0]):
        return []
    rest = head0[m.end():]
    if first not in _DECL_START and not re.match(r"\s*(?:\*|[A-Za-z_])",
                                                 rest):
        return []
    names = []
    for i, seg in enumerate(segs):
        head = seg.split("=", 1)[0]
        t = _strip_trailing_groups(head)
        # `u_char  hex[16] NXT_NONSTRING`: an upper-case attribute macro
        # after the declarator is not its name.
        while True:
            am = re.search(r"\s([A-Z][A-Z0-9_]*)$", t)
            if not am or len(IDENT.findall(t)) < 3:
                break
            t = _strip_trailing_groups(t[:am.start()])
        nm = re.search(r"[A-Za-z_]\w*$", t)
        if nm:
            # `nxt_str_t  name`: the last word, which is never the type itself.
            if i == 0 and len(IDENT.findall(t)) < 2:
                continue
            if nm.group(0) not in C_KEYWORDS:
                names.append(nm.group(0))
        else:
            fm = FNPTR_NAME.search(t)
            if fm:
                names.append(fm.group(1))
    return names


def local_scopes(mk: Masked, d):
    """name -> [(start, end)] offsets where that name is a local of d.

    A parameter is in scope for the whole body. A block-scope declaration is
    in scope from its statement to the end of the enclosing block, and a
    `for (int i = 0; ...)` declaration to the end of that loop. Inside those
    ranges the name is the local, not a file-scope symbol of the same name.
    Brace depth is read from brace_code, as for the top level.
    """
    out = defaultdict(list)
    lo, hi = d.open_off, d.close_off
    if lo is None or hi is None:
        return out
    for _line, name in d.param_sites:
        out[name].append((lo, hi))
    code, braces = mk.code, mk.brace_code
    match, st = {}, []
    for k in range(lo, hi + 1):
        if braces[k] == "{":
            st.append(k)
        elif braces[k] == "}" and st:
            match[st.pop()] = k
    blocks = [hi]           # end offset of each open block
    paren = 0
    stmt_start = lo + 1
    i = lo + 1

    def declare(text, start, end):
        for name in _local_declarators(text):
            out[name].append((start, end))

    def for_init(text, start, end):
        m = re.match(r"\s*for\s*\(", text)
        if not m:
            return False
        init = text[m.end():].split(";", 1)[0]
        declare(init, start, end)
        return True

    while i < hi:
        ch = code[i]
        b = braces[i]
        if ch in "([":
            paren += 1
        elif ch in ")]":
            paren = max(paren - 1, 0)
        elif b == "{" and paren == 0:
            stmt = code[stmt_start:i]
            if ("=" in _depth0(stmt) or re.match(r"\s*(?:\w+\s+)*"
                                                 r"(?:struct|union|enum)\b",
                                                 stmt)) \
                    and not stmt.rstrip().endswith(")"):
                # an initialiser, or a local aggregate: the statement goes on
                i = match.get(i, i) + 1
                continue
            for_init(stmt, stmt_start, match.get(i, hi))
            blocks.append(match.get(i, hi))
            stmt_start = i + 1
        elif b == "}" and paren == 0:
            if len(blocks) > 1:
                blocks.pop()
            stmt_start = i + 1
        elif ch == ";" and paren == 0:
            stmt = code[stmt_start:i]
            if not for_init(stmt, stmt_start, i):
                declare(stmt, stmt_start, blocks[-1])
            stmt_start = i + 1
        i += 1
    return out


def member_sites(mk: Masked, aggregates):
    """name -> [(start, end)] of each struct or union member declaration.

    `nxt_str_t  error;` in a struct names a member, not the file-static
    `error`. The member's own declaration is excluded, as a parameter's is;
    the type before it is still a use. Enums and initialisers are skipped:
    enum members are constants, and an initialiser holds expressions.
    """
    out = defaultdict(list)
    code = mk.code
    for stmt_start, body_open, body_close, _line in aggregates:
        head = code[stmt_start:body_open]
        if "=" in head or not re.search(r"\b(?:struct|union)\b", head):
            continue
        seg, paren = body_open + 1, 0
        for k in range(body_open + 1, body_close + 1):
            ch = code[k]
            if ch in "([":
                paren += 1
            elif ch in ")]":
                paren = max(paren - 1, 0)
            elif ch in ";{}" and paren == 0:
                text = re.sub(r":\s*\w+\s*$", "", code[seg:k])
                for name in _local_declarators(text):
                    out[name].append((seg, k))
                seg = k + 1
    return out


def index_usage(mk: Masked, defs, decls, objs, enums, known, aggregates=(),
                pp_names=frozenset(), code_names=frozenset()):
    """Usage rows of one file.

    pp_names are the constants, the only names an #if can test. code_names
    are the functions and objects.
    """
    excluded = set()
    # A macro's own name in its body is not expanded again, so it is not a
    # use of the macro: `#define NXT_ALIAS NXT_ALIAS`. It names the function
    # or object of that name, if there is one: the body of the nxt_debug()
    # macro reads the nxt_debug variable (src/nxt_log.h).
    for name, lo, hi in mk.define_spans:
        if name not in code_names:
            excluded.update((ln, name) for ln in range(lo, hi + 1))
    # An enum member's own definition is not a use of it, any more than a
    # function's is: every member used to count itself once, so a member used
    # only in tests read as having a production use.
    for name, _kind, line, _value in enums:
        excluded.add((line, name))
    for d in defs:
        excluded.add((d.line, d.name))
        excluded.update(d.param_sites)
        excluded.update(d.header_sites)
    for d in decls:
        excluded.add((d.line, d.name))
        excluded.update(d.param_sites)
    for o in objs:
        excluded.add((o.line, o.name))

    # line -> enclosing function
    encl = {}
    for d in defs:
        for ln in range(d.line, d.end_line + 1):
            encl[ln] = d.name
    # A reference inside a macro body belongs to the macro; that is the useful
    # answer ("reached via nxt_conn_connect"), and macros never nest in a
    # function body at the top level, so this cannot shadow a real one.
    for name, lo, hi in mk.define_spans:
        for ln in range(lo, hi + 1):
            encl[ln] = name

    # A parameter or local that shares a file-scope name is that local in
    # its own scope: `nxt_int_t error` in a function of src/nxt_http_error.c
    # is not the file-static `error`. Only names that are also file-scope
    # symbols matter here.
    shadow = defaultdict(list)
    scopes = [local_scopes(mk, d) for d in defs]
    scopes.append(member_sites(mk, aggregates))
    for sc in scopes:
        for name, ranges in sc.items():
            if name in known:
                shadow[name].extend(ranges)

    code = mk.usage_code
    out = []
    for m in IDENT.finditer(code):
        name = m.group(0)
        if name not in known:
            continue
        if name in shadow and any(lo <= m.start() <= hi
                                  for lo, hi in shadow[name]):
            continue
        # A struct or union member access never names a file-scope symbol, and
        # neither does a designated initialiser. Counting them inflates exactly
        # the symbols where a wrong answer costs most: the tree has 469 such
        # occurrences, on names like `status`, `error`, `ready_handler` and
        # `main` (e.g. `resp->status` at src/nxt_controller.c:1351), each of
        # which would otherwise read as a reference to the global of that name.
        k = m.start() - 1
        while k >= 0 and code[k] in " \t\n":
            k -= 1
        if k >= 0 and (code[k] == "." or (code[k] == ">" and k > 0
                                          and code[k - 1] == "-")):
            continue
        # `error:` as a label, and the `goto error` that reaches it, are not
        # references to the file-static `error` in src/nxt_http_error.c:19.
        j2 = m.end()
        while j2 < len(code) and code[j2] in " \t":
            j2 += 1
        if (j2 < len(code) and code[j2] == ":"
                and not code.startswith("::", j2)
                and (k < 0 or code[k] in ";{}:")):
            continue
        if k >= 0 and code[k].isalnum():
            w0 = k
            while w0 >= 0 and (code[w0].isalnum() or code[w0] == "_"):
                w0 -= 1
            if code[w0 + 1:k + 1] == "goto":
                continue
        line = mk.line_of(m.start())
        if (line, name) in excluded:
            continue
        if line in mk.pp_lines:
            # The preprocessor knows macros and nothing else: a function or
            # object named in #ifdef is a different, undefined name there.
            if name not in pp_names:
                continue
            kind = "pp"
        else:
            # A call has its `(` on the name's line, as everywhere in this
            # tree; the next line may be a restored #if condition.
            j = m.end()
            while j < len(code) and code[j] in " \t\r":
                j += 1
            kind = "call" if j < len(code) and code[j] == "(" else "ref"
        col = m.start() - mk.line_start[line - 1] + 1
        out.append((name, line, col, kind, encl.get(line, "-")))
    return out


# --------------------------------------------------------------------------
# Gates
# --------------------------------------------------------------------------

MIN_CODE_LINES = 40      # below this a .c file with no functions is fine
MAX_UNACCOUNTED = 0.15   # fraction of code lines the scanner may not attribute


def coverage(mk: Masked, defs, decls, objs, aggregates, spans, final_depth):
    """Account for every line of the file, and report what we could not.

    Every line must be explained as part of a top-level construct, a
    preprocessor directive, a comment, or blank. What is left over is the
    number that matters: a previous tree-sitter index reported a plausible
    symbol count while silently dropping 56% of nxt_router.c, so the gate is
    stated in lines against wc -l rather than in symbols.
    """
    lines = mk.src.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    total = len(lines)

    directive_lines = set()
    for line, raw in mk.directives:
        for k in range(raw.count("\n") + 1):
            directive_lines.add(line + k)

    covered = set()
    for lo, hi in spans:
        for ln in range(lo, hi + 1):
            covered.add(ln)
    for stmt_start, _open, body_close, _ln in aggregates:
        for ln in range(mk.line_of(stmt_start), mk.line_of(body_close) + 1):
            covered.add(ln)

    blank = set()
    code_lines = 0
    for idx in range(1, total + 1):
        st = mk.line_start[idx - 1]
        en = (mk.line_start[idx] - 1 if idx < len(mk.line_start)
              else len(mk.code))
        if not mk.code[st:en].strip():
            blank.add(idx)
        else:
            code_lines += 1

    accounted = covered | directive_lines | blank | mk.comment_lines
    unaccounted = [i for i in range(1, total + 1) if i not in accounted]

    return {
        "lines": total,
        "code_lines": code_lines,
        "defs": len(defs),
        "decls": len(decls),
        "objs": len(objs),
        "attributed": total - len(unaccounted),
        "unaccounted": len(unaccounted),
        "first_unaccounted": unaccounted[0] if unaccounted else 0,
        "final_depth": final_depth,
        "cond_conflicts": len(mk.cond_conflicts),
    }


def crosscheck_astgrep(root: str, files, astgrep: str):
    """Independent extraction of function definitions with a real C grammar.

    Returns (per-file name sets, ok). `ok` is False when ast-grep produced
    nothing at all, which means the cross-check is broken, NOT that the tree
    agrees. ast-grep fails to an empty set rather than an error, so an empty
    result is never evidence of agreement.
    """
    rule = ("id: unit_registry_fndef\n"
            "language: c\n"
            "rule:\n"
            "  kind: function_definition\n"
            "  has:\n"
            "    kind: function_declarator\n"
            "    stopBy: end\n"
            "    has:\n"
            "      kind: identifier\n"
            "      field: declarator\n"
            "      pattern: $NAME\n")
    with tempfile.NamedTemporaryFile("w", suffix=".yml", delete=False) as fh:
        fh.write(rule)
        rule_path = fh.name
    try:
        found = defaultdict(set)
        # Batch: ast-grep scans a directory tree far faster than N invocations.
        proc = subprocess.run(
            [astgrep, "scan", "-r", rule_path, "--json=stream",
             *[os.path.join(root, d) for d in SCAN_ROOTS
               if os.path.isdir(os.path.join(root, d))]],
            capture_output=True, text=True, timeout=300)
        nlines = 0
        for line in proc.stdout.splitlines():
            line = line.strip()
            if not line:
                continue
            nlines += 1
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue
            rel = os.path.relpath(d.get("file", ""), root)
            name = (d.get("metaVariables", {}).get("single", {})
                    .get("NAME", {}).get("text"))
            if name:
                found[rel].add(name)
        if proc.returncode != 0:
            return {}, False
        return found, nlines > 0 and bool(found)
    except (OSError, subprocess.SubprocessError):
        return {}, False
    finally:
        try:
            os.unlink(rule_path)
        except OSError:
            pass


