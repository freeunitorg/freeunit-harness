#!/usr/bin/env python3
"""relay -- the cross-machine channel: one GitHub issue that agents on different machines share.
Copyright (C) FreeUnit contributors.

  relay pull  <owner/repo#N>              copy new protocol lines from the issue to the local bus (tools/inbox)
  relay state <owner/repo#N>              print who holds each item, from the claim, takeover and done lines
  relay post  <owner/repo#N> <line...>    post one protocol line as an issue comment
  relay perf  <owner/repo#N> [--run]      list open perf requests; --run takes the oldest, runs it, posts the result

A protocol line starts a comment line (docs/relay.md):
  claim: <item> — <agent> — <branch>        takeover: <item> — <agent> — <reason>
  done: <item> — <url> — <evidence>         perf-request: <job> — <agent>   (then a ```job fenced block)
  perf-claim: <job> — <agent> — <lab>       perf-result: <job> — <agent> — <PERF line>
The separator is " — " (em dash) or " -- ". The agent is free text; the GitHub login is the trusted sender.

Only RELAY_TRUSTED logins (comma list, default: the login of the gh token) can make a perf request.
A request job may not name patches, configure arguments or AE, and REV_A, REV_B must be full SHAs.
Reads issues with `gh api` (RELAY_GH, default gh); RELAY_COMMENTS=<file.json> reads a saved list instead.
RELAY_PERF_JOB replaces tools/perf-job.sh (tests). RELAY_AGENT names this agent in the lines it posts.
State: run/relay/ (RELAY_DIR). Exit 2 on a usage error, 1 on a refused request, 75 when the lab is busy."""
import json, os, re, subprocess, sys
HERE = os.path.dirname(os.path.abspath(__file__))
STATE = os.environ.get("RELAY_DIR") or os.path.join(HERE, "..", "run", "relay")
GH = os.environ.get("RELAY_GH", "gh").split()
FOOTER = "\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_"
WORDS = ("claim", "takeover", "done", "perf-request", "perf-claim", "perf-result")
PROTO = re.compile(r"^\s*(" + "|".join(WORDS) + r"):\s+(.+?)\s*$", re.M)
SEP = re.compile(r"\s+(?:—|--)\s+")
FENCE = re.compile(r"```job\n(.*?)```", re.S)
BUS_KIND = {"claim": "claim", "takeover": "claim", "perf-claim": "claim", "perf-request": "request", "done": "fact", "perf-result": "fact"}
# The job keys a remote request may set. PATCH_*, CONFIGURE_ARGS* and AE are local-only: they name files or flags.
JOB_KEYS = ("JOB REV_A REV_B WORKLOAD CONNS DUR WARM REPS RATE APP_PROCS PERF STRACE STRACE_SEC STRACE_RATE "
            "NULL_GATE NULL_LIMIT_PCT PRIMARY FUNCS ISSUE EXPECT FALSIFY").split()
SHA = re.compile(r"[0-9a-f]{40}")
SAFE = re.compile(r"[A-Za-z0-9 ._:/%,=+()-]*")          # no quote, $, backtick, backslash or ;

def usage(msg): print("relay: " + msg, file=sys.stderr); sys.exit(2)
def refuse(msg): print("relay: " + msg, file=sys.stderr); sys.exit(1)

def target(arg):
    m = re.fullmatch(r"([\w.-]+)/([\w.-]+)#(\d+)", arg or "")
    if not m: usage(f"want owner/repo#N, got {arg!r}")
    return m.group(1), m.group(2), int(m.group(3))

def gh(*args, data=None):
    r = subprocess.run(GH + ["api", *args], input=data, capture_output=True, text=True)
    if r.returncode: refuse(f"gh api {' '.join(args)} failed: {r.stderr.strip()[:300]}")
    return r.stdout

def comments(t):
    if os.environ.get("RELAY_COMMENTS"):
        with open(os.environ["RELAY_COMMENTS"]) as f: return json.load(f)
    out, page = [], 1
    while True:                                          # plain pages: no --paginate, so any gh client works
        batch = json.loads(gh(f"repos/{t[0]}/{t[1]}/issues/{t[2]}/comments?per_page=100&page={page}"))
        out += batch
        if len(batch) < 100: return out
        page += 1

def lines(cs):
    """Yield one dict per protocol line: word, item, rest (the other fields), login, ts, url, body."""
    for c in cs:
        body = c.get("body") or ""
        for m in PROTO.finditer(body):
            parts = SEP.split(m.group(2))
            yield dict(word=m.group(1), item=parts[0], rest=parts[1:], login=c["user"]["login"],
                       ts=c["created_at"], url=c.get("html_url", ""), id=c["id"], body=body)

def state(cs):
    """item -> the line that holds it (claim or takeover), or the done line that closed it. Last line wins."""
    held = {}
    for l in lines(cs):
        if l["word"] in ("claim", "takeover", "done", "perf-claim", "perf-result"): held[l["item"]] = l
    return held

def slug(t): return f"{t[0]}-{t[1]}-{t[2]}"

def cmd_pull(t):
    os.makedirs(STATE, exist_ok=True)
    cur = os.path.join(STATE, slug(t) + ".cursor")
    last = int(open(cur).read().strip() or 0) if os.path.exists(cur) else 0
    inbox = load_inbox(); cs = comments(t); n = 0
    for l in lines(c for c in cs if c["id"] > last):
        text = f"{l['word']}: {' — '.join([l['item'], *l['rest']])} {l['url']}"
        text = " ".join(text.split())[:480]
        os.environ["INBOX_SENDER"] = f"{l['login']}@github"
        _, line = inbox.compose(BUS_KIND[l["word"]], text, ts=l["ts"]); inbox.append(line); n += 1
    if cs: open(cur, "w").write(str(max(c["id"] for c in cs)))
    print(f"relay: {n} line(s) from {t[0]}/{t[1]}#{t[2]}")

def load_inbox():
    import importlib.machinery, importlib.util
    loader = importlib.machinery.SourceFileLoader("inbox", os.path.join(HERE, "inbox")); sys.dont_write_bytecode = True
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("inbox", loader)); loader.exec_module(mod); return mod

def cmd_state(t):
    for item, l in sorted(state(comments(t)).items()):
        who = l["rest"][0] if l["rest"] else "?"
        status = "done" if l["word"] in ("done", "perf-result") else "held"
        print(f"{status:5} {item:28} {who} ({l['login']}, {l['ts']}) {l['url']}")

def post(t, text):
    gh(f"repos/{t[0]}/{t[1]}/issues/{t[2]}/comments", "--input", "-", data=json.dumps({"body": text + FOOTER}))

def cmd_post(t, words):
    text = " ".join(words)
    m = PROTO.match(text)
    if not m or m.start() != 0: usage(f"a line must start with one of {', '.join(w + ':' for w in WORDS)}")
    post(t, text); print("relay: posted")

def check_job(text):
    """Return (job name, normalised job text) or refuse. Mirrors read_kv in perf-job.sh, then narrows it."""
    kv = {}
    for n, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line: continue
        m = re.fullmatch(r"([A-Z_][A-Z0-9_]*)=(.*)", line)
        if not m: refuse(f"job line {n}: not KEY=VALUE")
        k, v = m.group(1), m.group(2).strip().strip("\"'")
        if k not in JOB_KEYS: refuse(f"job line {n}: key {k} is not allowed in a remote request")
        if not SAFE.fullmatch(v): refuse(f"job line {n}: {k} has a character outside {SAFE.pattern}")
        kv[k] = v
    for k in ("JOB", "REV_A", "REV_B"):
        if not kv.get(k): refuse(f"the job needs {k}")
    for k in ("REV_A", "REV_B"):
        if not SHA.fullmatch(kv[k]): refuse(f"{k} must be a full 40-character SHA")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", kv["JOB"]): refuse("JOB must be a short file-safe name")
    return kv["JOB"], "".join(f"{k}={v}\n" for k, v in kv.items())

def trusted():
    names = os.environ.get("RELAY_TRUSTED")
    if names: return {n.strip() for n in names.split(",") if n.strip()}
    return {json.loads(gh("user"))["login"]}

def open_requests(cs):
    """Perf requests from trusted logins with no later perf-claim or perf-result for the same job."""
    ok, reqs, closed = trusted(), {}, set()
    for l in lines(cs):
        if l["word"] == "perf-request" and l["login"] in ok: reqs.setdefault(l["item"], l)
        elif l["word"] in ("perf-claim", "perf-result"): closed.add(l["item"])
    return [l for job, l in reqs.items() if job not in closed]

def cmd_perf(t, run):
    reqs = open_requests(comments(t))
    if not run:
        for l in reqs: print(f"open  {l['item']:28} {l['login']} {l['ts']} {l['url']}")
        return
    if not reqs: print("relay: no open perf request"); return
    l = reqs[0]; m = FENCE.search(l["body"])
    if not m: refuse(f"{l['url']}: no ```job block")
    job, text = check_job(m.group(1))
    if job != l["item"]: refuse(f"{l['url']}: JOB={job} does not match the request line ({l['item']})")
    jobs = os.path.join(STATE, "jobs"); os.makedirs(jobs, exist_ok=True)
    path = os.path.join(jobs, job + ".job")
    with open(path, "w") as f: f.write(f"# from {l['url']}\n" + text)
    tool = os.environ.get("RELAY_PERF_JOB") or os.path.join(HERE, "perf-job.sh")
    chk = subprocess.run([tool, path], env=dict(os.environ, PERF_JOB_CHECK="1"), capture_output=True, text=True)
    if chk.returncode: refuse(f"perf-job.sh refused {path}: {chk.stderr.strip()[-300:]}")
    lab = os.environ.get("RELAY_LAB", "lab")
    post(t, f"perf-claim: {job} — {agent()} — {lab}")
    r = subprocess.run([tool, path], stdout=subprocess.PIPE, text=True)  # progress stays on stderr
    perf = (r.stdout.strip().splitlines() or ["(no PERF line)"])[-1]
    if r.returncode == 75: perf = "BUSY, nothing measured. Post the request again later. " + perf
    elif r.returncode: perf = f"ERROR exit {r.returncode}. " + perf
    post(t, f"perf-result: {job} — {agent()} — {perf}\n\n```\n{report(perf)}\n```")
    print(perf); sys.exit(75 if r.returncode == 75 else r.returncode)

def agent(): return os.environ.get("RELAY_AGENT") or os.environ.get("INBOX_SENDER") or "laptop-perf"

def report(perf):
    """compare.txt from the PERF line, cut to fit one comment. The numbers are the tool's, copied as is."""
    m = re.search(r"report (\S+compare\.txt)", perf)
    if not m or not os.path.exists(m.group(1)): return perf
    return open(m.group(1)).read()[:60000]

def main(argv):
    if len(argv) < 2 or argv[0] not in ("pull", "state", "post", "perf"): usage("usage: relay pull|state|post|perf <owner/repo#N> ...")
    cmd, t, rest = argv[0], target(argv[1]), argv[2:]
    if cmd == "pull" and not rest: cmd_pull(t)
    elif cmd == "state" and not rest: cmd_state(t)
    elif cmd == "post" and rest: cmd_post(t, rest)
    elif cmd == "perf" and rest in ([], ["--run"]): cmd_perf(t, rest == ["--run"])
    else: usage(f"bad arguments for {cmd}")

if __name__ == "__main__": main(sys.argv[1:])
