#!/bin/sh
# unitd-ctl — lifecycle for the harness's dev unitd.
#
# Why this is a script and not three lines of Makefile: a unitd that is started
# carelessly is a unitd that outlives you. The main process re-parents its
# router, controller and application workers; SIGTERM to the main pid alone
# leaves them running, and a runner that dies abnormally (SIGKILL, a crashed
# pytest) leaves the whole tree orphaned to init. On a shared box those
# survivors hold the listen ports and, for io_uring builds, pinned ring memory.
#
# So: unitd is started with setsid into its OWN process group, the group id is
# recorded before anything else can go wrong, and stopping walks a bounded
# escalation ladder against the GROUP — never an unbounded `wait` on one pid.
# Every kill target is additionally confirmed to be a real unitd by its process
# image (/proc/<pid>/exe), because a pid is a recyclable number and this script
# must never signal a stranger's process.
#
# This mirrors the discipline in tools/bench-engines.sh, which arrived at it the
# hard way.

set -u

die() { printf 'unitd-ctl: %s\n' "$*" >&2; exit 1; }

# Not ${RUN_DIR:?}: its exit status is 1 in bash and 2 in dash and ash.
[ -n "${RUN_DIR:-}" ] || die "RUN_DIR not set"
[ -n "${BUILD_DIR:-}" ] || die "BUILD_DIR not set"

PORT="${PORT:-8080}"

UNITD="$BUILD_DIR/sbin/unitd"
CONTROL="${CONTROL:-$RUN_DIR/control.sock}"
PIDFILE="$RUN_DIR/unit.pid"
LOGFILE="$RUN_DIR/unit.log"
PGIDFILE="$RUN_DIR/unitd.pgid"
STATEDIR="$RUN_DIR/state"

STOP_GRACE="${STOP_GRACE:-10}"     # seconds before escalating TERM -> KILL
START_TIMEOUT="${START_TIMEOUT:-15}"


# --- ownership guards --------------------------------------------------------

proc_is_unitd() {   # pid -> 0 if the process image really is our unitd
    pu_pid="$1"
    pu_exe=$(readlink "/proc/$pu_pid/exe" 2>/dev/null) || return 1
    case "$pu_exe" in
        "$UNITD"|"$UNITD "*|*"/unitd"|*"/unitd (deleted)") return 0 ;;
        *) return 1 ;;
    esac
}

# The process group comes from /proc/<pid>/stat, not from ps or pgrep: busybox
# has no "ps -p" and its pgrep has no -g, so on Alpine without procps they
# print nothing. Field 5 of the stat line is the group. The command name in
# field 2 can hold spaces and ")", so the fields are counted after the last ")".
proc_pgid() {       # pid -> its process group id on stdout; 1 if it is gone
    { read -r pp_stat < "/proc/$1/stat"; } 2>/dev/null || return 1
    pp_rest=${pp_stat##*) }
    # shellcheck disable=SC2086  # split into state, ppid, pgrp, ...
    set -- $pp_rest
    [ -n "${3:-}" ] || return 1
    printf '%s\n' "$3"
}

# group_pids PGID: the pids in group PGID, one per line.
group_pids() {
    gp_want="$1"
    for gp_d in /proc/[0-9]*; do
        { read -r gp_stat < "$gp_d/stat"; } 2>/dev/null || continue
        gp_rest=${gp_stat##*) }
        # shellcheck disable=SC2086  # split into state, ppid, pgrp, ...
        set -- $gp_rest
        [ "${3:-}" = "$gp_want" ] && printf '%s\n' "${gp_d#/proc/}"
    done
    return 0
}

# A recorded pgid is only a kill target if some process in it is a live unitd.
# Otherwise the id has been recycled and belongs to someone else entirely.
group_is_ours() {   # pgid -> 0 if safe to signal
    go_pgid="$1"
    case $go_pgid in ''|*[!0-9]*) return 1 ;; esac
    for go_p in $(group_pids "$go_pgid"); do
        proc_is_unitd "$go_p" && return 0
    done
    return 1
}

read_pgid() {
    [ -f "$PGIDFILE" ] || return 1
    tr -d ' \t\r\n' < "$PGIDFILE" 2>/dev/null
}

# --- commands ----------------------------------------------------------------

cmd_start() {
    [ -x "$UNITD" ] || die "no $UNITD — run 'make build' first"

    if cmd_status >/dev/null 2>&1; then
        printf '%s\n' "already running (pgid $(read_pgid)); use 'make restart'"
        return 0
    fi

    mkdir -p "$RUN_DIR" "$STATEDIR"

    # AF_UNIX sun_path is ~108 bytes and unitd appends to the control path
    # while binding; a deep RUN_DIR fails at bind time with a confusing error.
    if [ ${#CONTROL} -gt 90 ]; then
        die "control socket path too long (${#CONTROL} chars): $CONTROL
     set RUN_DIR to something shorter"
    fi

    rm -f "$PIDFILE"
    printf '%s\n' "==> starting $UNITD"

    # setsid gives unitd its own session/process group so cleanup has a single
    # kill target covering router + controller + workers.
    setsid "$UNITD" --no-daemon \
        --control "unix:$CONTROL" \
        --pid "$PIDFILE" \
        --log "$LOGFILE" \
        --statedir "$STATEDIR" \
        --tmpdir "$RUN_DIR" \
        >>"$LOGFILE" 2>&1 &
    st_spawn_pid=$!

    # Record a kill target NOW. setsid makes the child the leader of its new
    # group, so its pid IS the pgid. If start fails past this point the stop
    # path can still reap the group; without this an early failure leaks it.
    printf '%s\n' "$st_spawn_pid" > "$PGIDFILE"

    # Integer ticks of 0.2s — no bc, no float arithmetic in a wait loop.
    st_ticks=0 st_max_ticks=$(( START_TIMEOUT * 5 ))
    while [ "$st_ticks" -lt "$st_max_ticks" ]; do
        if [ -s "$PIDFILE" ]; then
            st_main=$(tr -d ' \t\r\n' < "$PIDFILE")
            # Prefer the authoritative pid unitd reports over the spawn pid.
            if [ -n "$st_main" ] && kill -0 "$st_main" 2>/dev/null; then
                # Keep the spawn pid when the group cannot be read: an
                # empty file is no kill target at all.
                st_pgid=$(proc_pgid "$st_main") && printf '%s\n' "$st_pgid" > "$PGIDFILE"
                printf '%s\n' "==> unitd running (pid $st_main, pgid $(read_pgid))"
                printf '%s\n' "    log     $LOGFILE"
                printf '%s\n' "    control $CONTROL"
                return 0
            fi
        fi
        kill -0 "$st_spawn_pid" 2>/dev/null || break
        sleep 0.2
        st_ticks=$(( st_ticks + 1 ))
    done

    echo "unitd failed to start within ${START_TIMEOUT}s; last log lines:" >&2
    tail -20 "$LOGFILE" >&2 2>/dev/null || true
    cmd_stop >/dev/null 2>&1 || true
    return 1
}

cmd_stop() {
    sp_pgid=$(read_pgid) || { printf '%s\n' "not running (no $PGIDFILE)"; return 0; }

    if ! group_is_ours "$sp_pgid"; then
        printf '%s\n' "not running (pgid $sp_pgid holds no unitd; stale file)"
        rm -f "$PGIDFILE" "$PIDFILE"
        return 0
    fi

    echo "==> stopping unitd group $sp_pgid"
    # No "--": the kill builtin of dash rejects it and sends no signal.
    # group_is_ours has checked that the pgid is a number.
    kill -TERM "-$sp_pgid" 2>/dev/null || true

    sp_ticks=0 sp_max_ticks=$(( STOP_GRACE * 5 ))
    while [ "$sp_ticks" -lt "$sp_max_ticks" ]; do
        group_is_ours "$sp_pgid" || { echo "==> stopped"; rm -f "$PGIDFILE" "$PIDFILE"; return 0; }
        sleep 0.2
        sp_ticks=$(( sp_ticks + 1 ))
    done

    echo "==> grace period expired, SIGKILL to group $sp_pgid"
    kill -KILL "-$sp_pgid" 2>/dev/null || true
    sleep 0.5

    if group_is_ours "$sp_pgid"; then
        die "group $sp_pgid survived SIGKILL — investigate before rerunning"
    fi
    echo "==> stopped (killed)"
    rm -f "$PGIDFILE" "$PIDFILE"
}

cmd_status() {
    ss_pgid=$(read_pgid) || { echo "stopped"; return 1; }
    if group_is_ours "$ss_pgid"; then
        ss_main=""
        [ -f "$PIDFILE" ] && ss_main=$(tr -d ' \t\r\n' < "$PIDFILE")
        printf '%s\n' "running (pid ${ss_main:-?}, pgid $ss_pgid)"
        # As "pgrep -g PGID -a": the pid and the command line.
        for ss_p in $(group_pids "$ss_pgid"); do
            ss_cmd=$(tr '\0' ' ' < "/proc/$ss_p/cmdline" 2>/dev/null) || continue
            printf '    %s %s\n' "$ss_p" "${ss_cmd% }"
        done
        return 0
    fi
    printf '%s\n' "stopped (stale pgid file: $ss_pgid)"
    return 1
}

cmd_restart() { cmd_stop; cmd_start; }

cmd_logs() {
    [ -f "$LOGFILE" ] || die "no log at $LOGFILE"
    tail -f "$LOGFILE"
}

# A minimal known-good config so `make dev` ends at something you can curl.
cmd_config() {
    [ -S "$CONTROL" ] || die "no control socket at $CONTROL — is unitd running?"
    cf_out=$(curl -s --max-time 10 --unix-socket "$CONTROL" -X PUT -d '{
      "listeners": {
        "*:'"$PORT"'": { "pass": "routes" }
      },
      "routes": [
        { "action": { "return": 200 } }
      ]
    }' http://localhost/config 2>&1)

    case "$cf_out" in
        *'"success"'*) echo "==> configured: http://localhost:$PORT/ returns 200" ;;
        *) echo "config PUT failed:" >&2; printf '%s\n' "$cf_out" >&2; return 1 ;;
    esac
}

case "${1:-}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    restart) cmd_restart ;;
    status)  cmd_status ;;
    logs)    cmd_logs ;;
    config)  cmd_config ;;
    *) die "usage: unitd-ctl {start|stop|restart|status|logs|config}" ;;
esac
